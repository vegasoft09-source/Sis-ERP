@model IEnumerable<Hevelab2026.Models.Cotizacion>

@{
    ViewData["Title"] = "Cotizaciones";
    ViewData["Breadcrumbs"] = new[] {
        ("Dashboard", "/"),
        ("Ventas", "#"),
        ("Cotizaciones", "/Cotizaciones")
    };
}

    <!-- KPI ROW -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="cl-kpi">
                <div class="cl-kpi__icon cl-kpi__icon--blue">
                    <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                </div>
                <div>
                    <div class="cl-kpi__label">TOTAL COTIZADO</div>
                    <div class="cl-kpi__value">S/ @Model.Sum(c => c.Total).ToString("N0")</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="cl-kpi">
                <div class="cl-kpi__icon cl-kpi__icon--green">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div>
                    <div class="cl-kpi__label">APROBADAS</div>
                    <div class="cl-kpi__value" style="color: #16a34a;">@Model.Count(c => c.Estado == "Aprobado")</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="cl-kpi">
                <div class="cl-kpi__icon" style="background:#fef08a; color:#ca8a04;">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div>
                    <div class="cl-kpi__label">PENDIENTES</div>
                    <div class="cl-kpi__value" style="color: #ca8a04;">@Model.Count(c => c.Estado == "Pendiente")</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="cl-kpi">
                <div class="cl-kpi__icon" style="background:#ffe4e6; color:#e11d48;">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                </div>
                <div>
                    <div class="cl-kpi__label">RECHAZADAS</div>
                    <div class="cl-kpi__value">@Model.Count(c => c.Estado == "Rechazado")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h1 class="cl-title">Cotizaciones</h1>
            <p class="cl-subtitle">Gestiona y realiza seguimiento a tus propuestas comerciales.</p>
        </div>
        <a asp-controller="Cotizaciones" asp-action="Create" class="cl-btn-primary">
            <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nueva Cotización
        </a>
    </div>

    <!-- FILTROS -->
    <div class="cl-filters mb-3">
        <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 align-items-center" style="width: 100%;">
            <div class="cl-search" style="flex: 1;">
                <svg class="cl-search__ico" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <input type="text" class="cl-search__input" placeholder="Rango de fecha..." />
            </div>

            <div class="cl-search" style="flex: 2;">
                <svg class="cl-search__ico" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" class="cl-search__input" name="cliente" placeholder="Buscar cliente..." />
            </div>

            <select name="estado" class="cl-select" style="flex: 1;">
                <option value="">Todos los estados</option>
                <option value="Pendiente">Pendiente</option>
                <option value="Aprobado">Aprobado</option>
                <option value="Rechazado">Rechazado</option>
            </select>

            <button type="submit" class="cl-btn-secondary">
                <svg viewBox="0 0 24 24"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                Filtrar
            </button>
        </form>
    </div>

    <!-- TABLA -->
    <div class="cl-card">
        <div class="cl-table-wrap">
            <table class="cl-table">
                <thead>
                    <tr>
                        <th class="cl-th" style="width:120px;">Número</th>
                        <th class="cl-th" style="width:110px;">Fecha</th>
                        <th class="cl-th">Cliente / Razón Social</th>
                        <th class="cl-th cl-hide-sm">RUC</th>
                        <th class="cl-th cl-hide-sm" style="text-align: right;">Subtotal</th>
                        <th class="cl-th" style="text-align: right;">Total</th>
                        <th class="cl-th" style="text-align: center;">Estado</th>
                        <th class="cl-th" style="text-align: center; width:100px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="cl-tr" style="cursor: pointer;" ondblclick="window.location.href='/Cotizaciones/Details/@item.Id'" title="Doble clic para ver detalle">
                            <td class="cl-td"><span class="cl-code" style="color:#4338ca;">@item.NumeroPedido</span></td>
                            <td class="cl-td cl-hide-sm">@item.FechaCreacion.ToString("dd/MMM/yyyy")</td>
                            <td class="cl-td">
                                <div class="cl-cell-name">@item.Cliente</div>
                                <div class="cl-cell-type">@item.RazonSocial</div>
                            </td>
                            <td class="cl-td cl-hide-sm"><span class="cl-mono">@item.RUC</span></td>
                            <td class="cl-td cl-hide-sm" style="text-align: right; font-weight:600;">@(item.Moneda == "PEN" ? "S/" : "$") @item.Subtotal.ToString("N2")</td>
                            <td class="cl-td" style="text-align: right; font-weight: 800; color: var(--text-primary);">@(item.Moneda == "PEN" ? "S/" : "$") @item.Total.ToString("N2")</td>
                            <td class="cl-td" style="text-align: center;">
                                @if (item.Estado == "Pendiente")
                                {
                                    <span class="cl-badge" style="background:#fef08a; color:#ca8a04;">BORRADOR</span>
                                }
                                else if (item.Estado == "Aprobado")
                                {
                                    <span class="cl-badge cl-badge--on">ACEPTADO</span>
                                }
                                else if (item.Estado == "Rechazado")
                                {
                                    <span class="cl-badge" style="background:#ffe4e6; color:#e11d48;">RECHAZADO</span>
                                }
                                else
                                {
                                    <span class="cl-badge" style="background:#e0e7ff; color:#4338ca;">ENVIADO</span>
                                }
                            </td>
                            <td class="cl-td" style="text-align: center;">
                                <div class="cl-actions" style="justify-content: center;">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="cl-act" title="Ver Detalle">
                                        <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="cl-act" title="Editar">
                                        <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
                                    </a>
                                    @if (item.Estado != "Aprobado" && item.Estado != "Rechazado")
                                    {
                                        <a asp-action="ConvertirAOrden" asp-route-id="@item.Id" class="cl-act" title="Convertir a Orden" style="color: #4338ca;">
                                            <svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINATION -->
        <div class="cl-foot">
            <span>Mostrando @Model.Count() cotizaciones</span>
            <div class="frm-page-numbers" id="coti-pagination" style="display:flex; gap:5px;">
                <button type="button" class="cl-act"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg></button>
                <button type="button" class="cl-act" style="background:var(--sys-primary); color:white; border-color:var(--sys-primary);">1</button>
                <button type="button" class="cl-act">2</button>
                <button type="button" class="cl-act">3</button>
                <span style="display:flex; align-items:flex-end; padding:0 5px;">...</span>
                <button type="button" class="cl-act">25</button>
                <button type="button" class="cl-act"><svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg></button>
            </div>
        </div>
    </div>

@section Scripts {
<script>
    // Pagination Mock
    document.querySelectorAll('#coti-pagination .cl-act').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            if (!this.innerHTML.includes('svg')) {
                document.querySelectorAll('#coti-pagination .cl-act').forEach(b => {
                    b.style.background = '';
                    b.style.color = '';
                    b.style.borderColor = '';
                });
                this.style.background = 'var(--sys-primary)';
                this.style.color = 'white';
                this.style.borderColor = 'var(--sys-primary)';
            }
        });
    });
</script>
}