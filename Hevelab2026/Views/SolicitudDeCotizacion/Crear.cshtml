@model Hevelab2026.Models.Compras.SolicitudCompraFormModel
@{
    ViewData["Title"] = "Nueva solicitud";
}

<div class="max-w-2xl mx-auto space-y-6">
    <h2 class="text-xl font-bold text-slate-900">Nueva solicitud de cotización</h2>
    <form method="post" class="bg-white border border-slate-200 rounded-2xl p-6 space-y-4">
        @Html.AntiForgeryToken()
        <div>
            <label asp-for="ProveedorId" class="block text-xs font-bold text-slate-500 uppercase mb-1"></label>
            <select asp-for="ProveedorId" asp-items="ViewBag.Proveedores" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm">
                <option value="">— Seleccione proveedor —</option>
            </select>
            <span asp-validation-for="ProveedorId" class="text-red-500 text-xs"></span>
        </div>
        <div>
            <label asp-for="Referencia" class="block text-xs font-bold text-slate-500 uppercase mb-1"></label>
            <input asp-for="Referencia" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm" placeholder="SOL-0001" />
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="FechaLimite" class="block text-xs font-bold text-slate-500 uppercase mb-1"></label>
                <input asp-for="FechaLimite" type="date" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm" />
            </div>
            <div>
                <label asp-for="TotalEstimado" class="block text-xs font-bold text-slate-500 uppercase mb-1"></label>
                <input asp-for="TotalEstimado" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm" />
            </div>
        </div>
        <div>
            <label asp-for="Observaciones" class="block text-xs font-bold text-slate-500 uppercase mb-1"></label>
            <textarea asp-for="Observaciones" rows="3" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm"></textarea>
        </div>
        <div class="flex gap-3 justify-end">
            <a href="/SolicitudDeCotizacion" class="px-4 py-2 text-sm font-semibold text-slate-600">Cancelar</a>
            <button type="submit" class="px-5 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-xl">Crear solicitud</button>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
