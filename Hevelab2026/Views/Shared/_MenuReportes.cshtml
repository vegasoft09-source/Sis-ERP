        <a href="/Reportes/Empleados" style="display: flex; align-items: center; gap: 10px; padding: 10px 15px; border-radius: 8px; font-size: 13px; font-weight: 600; color: @(activeMenu == "Empleados" ? "#3730a3" : "var(--text-secondary)"); background: @(activeMenu == "Empleados" ? "#eef2ff" : "transparent"); text-decoration: none;">
