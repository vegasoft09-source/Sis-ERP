@{
    var activeMenu = ViewBag.ActiveMenu as string ?? "Ventas";
}
<div class="cl-card no-print" style="width: 250px; min-height: 500px; padding: 20px; flex-shrink: 0;">
    <h3 style="font-size: 14px; font-weight: 800; color: var(--text-primary); margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px solid var(--border-color);">
        Módulos
    </h3>
    <div style="display: flex; flex-direction: column; gap: 5px;">
        <a href="/Reportes/Ventas" style="display: flex; align-items: center; gap: 10px; padding: 10px 15px; border-radius: 8px; font-size: 13px; font-weight: 600; color: @(activeMenu == "Ventas" ? "#3730a3" : "var(--text-secondary)"); background: @(activeMenu == "Ventas" ? "#eef2ff" : "transparent"); text-decoration: none;">
            <svg viewBox="0 0 24 24" style="width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2;"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            Ventas
        </a>
