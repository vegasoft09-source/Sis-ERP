</style>

<!-- 5. Scripts: Paginación, Ordenamiento, Modal, Filtros y Exportación (Cliente) -->
<script>
    function showToast(message, type = "success") {
        var color = "#10b981"; // success
        if (type === "warning") color = "#f59e0b";
        if (type === "error") color = "#ef4444";
        if (type === "info") color = "#3b5bdb";
        
        var iconSvg = "";
        if (type === "success") {
            iconSvg = `<svg viewBox="0 0 24 24" style="width:18px;height:18px;fill:none;stroke:#10b981;stroke-width:3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
        } else if (type === "error") {
            iconSvg = `<svg viewBox="0 0 24 24" style="width:18px;height:18px;fill:none;stroke:#ef4444;stroke-width:3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`;
        } else if (type === "warning") {
            iconSvg = `<svg viewBox="0 0 24 24" style="width:18px;height:18px;fill:none;stroke:#f59e0b;stroke-width:2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`;
        } else {
            iconSvg = `<svg viewBox="0 0 24 24" style="width:18px;height:18px;fill:none;stroke:#3b5bdb;stroke-width:2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>`;
        }

        var toastHtml = `
            <div class="cta-toast" style="position: fixed; top: 24px; right: 24px; background: #ffffff; border-left: 4px solid ${color}; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); border-radius: 8px; padding: 14px 18px; z-index: 10000; display: flex; align-items: center; gap: 12px; min-width: 300px; max-width: 420px; box-sizing: border-box; pointer-events: auto; border: 1px solid #e2e8f0; border-left-color: ${color}; animation: toastSlideIn 300ms cubic-bezier(0.16, 1, 0.3, 1) forwards;">
                <div style="flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 22px; height: 22px;">
                    ${iconSvg}
                </div>
                <div style="flex: 1; font-size: 13px; font-weight: 500; color: #1e293b; line-height: 1.4;">
                    ${message}
                </div>
                <button class="toast-close-btn" style="background: none; border: none; font-size: 18px; color: #94a3b8; cursor: pointer; padding: 2px; line-height: 1; transition: color 0.2s;" onmouseover="this.style.color='#1e293b'" onmouseout="this.style.color='#94a3b8'">&times;</button>
            </div>
        `;
        
        var container = document.getElementById("toast-container");
        if (!container) {
            container = document.createElement("div");
            container.id = "toast-container";
            container.style.position = "fixed";
            container.style.top = "24px";
            container.style.right = "24px";
            container.style.zIndex = "9999";
            container.style.display = "flex";
            container.style.flexDirection = "column";
            container.style.gap = "12px";
            container.style.pointerEvents = "none";
            document.body.appendChild(container);
        }
        
        container.insertAdjacentHTML("beforeend", toastHtml);
        var lastToast = container.lastElementChild;
        
        var dismissTimeout = setTimeout(function() {
            dismissToast(lastToast);
        }, 4500);
        
        function dismissToast(el) {
            if (el.classList.contains("toast-closing")) return;
            el.classList.add("toast-closing");
            clearTimeout(dismissTimeout);
            
            el.style.animation = "toastSlideOut 300ms cubic-bezier(0.16, 1, 0.3, 1) forwards";
            setTimeout(function() {
                el.remove();
            }, 300);
        }
        
        var closeBtn = lastToast.querySelector(".toast-close-btn");
        closeBtn.onclick = function() {
            dismissToast(lastToast);
        };
    }
    window.showToast = showToast;

    document.addEventListener("DOMContentLoaded", function() {
        // Elementos DOM Filtros
        var inputSearch = document.getElementById("filter-search");
        var selectTipo = document.getElementById("filter-tipo");
        var selectEstado = document.getElementById("filter-estado");
        var selectMoneda = document.getElementById("filter-moneda");
        var inputFechaDesde = document.getElementById("filter-fecha-desde");
        var inputFechaHasta = document.getElementById("filter-fecha-hasta");
        
        var btnFiltrar = document.getElementById("btn-filtrar");
        var btnLimpiar = document.getElementById("btn-limpiar");
        var btnExportar = document.getElementById("btn-exportar");
        
        // Elementos DOM Tabla y Paginador
        var tableBody = document.getElementById("tabla-body");
        var selectPageSize = document.getElementById("select-page-size");
        var paginadorContainer = document.getElementById("paginacion-container");
        var paginadorIndicador = document.getElementById("paginacion-indicador");
        var footerText = document.getElementById("footer-mostrando-text");
        
        // Elementos DOM Estadísticas
        var statTotalEl = document.getElementById("stat-total");
        var statEmitidasEl = document.getElementById("stat-emitidas");
        var statAnuladasEl = document.getElementById("stat-anuladas");
        var statMontoEl = document.getElementById("stat-monto");
        
        // Totales generales footer tabla
        var totalBaseEl = document.getElementById("total-base");
        var totalIgvEl = document.getElementById("total-igv");
        var totalTotalEl = document.getElementById("total-total");
        
        // Elementos Modal
        var modal = document.getElementById("detalle-modal");
        var modalCerrarX = document.getElementById("modal-cerrar-x");
        var modalCerrarBtn = document.getElementById("modal-cerrar-btn");
        var modalImprimirBtn = document.getElementById("modal-imprimir-btn");
        
        // Datos y estado local de UI
        var allRows = Array.from(document.querySelectorAll(".factura-row"));
        var filteredRows = [...allRows]; // Filas que pasan el filtro actual
        
        var currentPage = 1;
        var pageSize = 5;
        
        var currentSortCol = null; // Índice de columna de ordenamiento activo
        var currentSortAsc = true;  // Orden ascendente/descendente
        var activeCdrTab = "pendientes";
        
        // Función de formateo de moneda general
        function formatNumber(val) {
            return val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        
        // --- 1. APLICAR FILTROS (AND lógico) ---
        function aplicarFiltros() {
            var searchVal = inputSearch.value.trim().toLowerCase();
            var tipoVal = selectTipo.value;
            var estadoVal = selectEstado.value;
            var monedaVal = selectMoneda.value;
            var desdeVal = inputFechaDesde.value ? new Date(inputFechaDesde.value) : null;
            var hastaVal = inputFechaHasta.value ? new Date(inputFechaHasta.value) : null;
            
            // Establecer horas a 0 en fechas para comparación justa
            if (desdeVal) desdeVal.setHours(0, 0, 0, 0);
            if (hastaVal) hastaVal.setHours(23, 59, 59, 999);
            
            filteredRows = allRows.filter(function(row) {
                var numero = row.getAttribute("data-numero").toLowerCase();
                var cliente = row.getAttribute("data-cliente").toLowerCase();
                var tipo = row.getAttribute("data-tipo");
                var estado = row.getAttribute("data-estado");
                var moneda = row.getAttribute("data-moneda");
                var fechaStr = row.getAttribute("data-fecha");
                var cdrProcesado = row.getAttribute("data-cdr-procesado") || "false";
                var fecha = new Date(fechaStr);
                fecha.setHours(12, 0, 0, 0); // Estabilizar zona horaria
                
                var matchSearch = !searchVal || (numero.indexOf(searchVal) !== -1 || cliente.indexOf(searchVal) !== -1);
                var matchTipo = !tipoVal || tipo === tipoVal;
                var matchEstado = !estadoVal || estado === estadoVal;
                var matchMoneda = !monedaVal || moneda === monedaVal;
                var matchFechaDesde = !desdeVal || fecha >= desdeVal;
                var matchFechaHasta = !hastaVal || fecha <= hastaVal;
                var matchCdr = cdrProcesado === (activeCdrTab === "enviadas" ? "true" : "false");
                
                return matchSearch && matchTipo && matchEstado && matchMoneda && matchFechaDesde && matchFechaHasta && matchCdr;
            });
            
            currentPage = 1; // Reiniciar a página 1 al filtrar
            
            recalcularEstadisticas();
            aplicarOrdenamiento(false); // Mantener orden actual pero aplicar sobre los nuevos resultados
            renderTabla();
        }
        
        // --- 6. RESUMEN ESTADÍSTICO SUPERIOR & TOTALES FOOTER ---
        function recalcularEstadisticas() {
            var totalFacturas = filteredRows.length;
            var emitidas = 0;
            var anuladas = 0;
            var totalMontoPen = 0;
            
            var totalBase = 0;
            var totalIgv = 0;
            var totalTotal = 0;
            
            filteredRows.forEach(function(row) {
                var estado = row.getAttribute("data-estado");
                var moneda = row.getAttribute("data-moneda");
                var base = parseFloat(row.getAttribute("data-base")) || 0;
                var igv = parseFloat(row.getAttribute("data-igv")) || 0;
                var total = parseFloat(row.getAttribute("data-total")) || 0;
                
                // Conteo de Estados
                if (estado === "Emitida") emitidas++;
                if (estado === "Anulada") anuladas++;
                
                // Monto Total en PEN (se calcula asumiendo un tipo de cambio ficticio de 3.75 para USD)
                var tc = (moneda === "USD") ? 3.75 : 1.00;
                totalMontoPen += (total * tc);
                
                // Totales de la tabla
                totalBase += base;
                totalIgv += igv;
                totalTotal += total;
            });
            
            // Render de Estadísticas (Valores protegidos contra nulos si la barra no existe)
            if (statTotalEl) statTotalEl.textContent = totalFacturas;
            if (statEmitidasEl) statEmitidasEl.textContent = emitidas;
            if (statAnuladasEl) statAnuladasEl.textContent = anuladas;
            if (statMontoEl) statMontoEl.textContent = "S/ " + formatNumber(totalMontoPen);
            
            // Render de Totales Footer
            totalBaseEl.textContent = formatNumber(totalBase);
            totalIgvEl.textContent = formatNumber(totalIgv);
            totalTotalEl.textContent = formatNumber(totalTotal);
        }
        
        // --- 1. RENDEREAR TABLA CON PAGINACIÓN ---
        function renderTabla() {
            // Limpiar tabla completa temporalmente
            allRows.forEach(function(r) { r.style.display = "none"; });
            
            var totalRegistros = filteredRows.length;
            pageSize = (selectPageSize.value === "all") ? totalRegistros : parseInt(selectPageSize.value);
            
            var totalPages = Math.ceil(totalRegistros / pageSize) || 1;
            if (currentPage > totalPages) currentPage = totalPages;
            
            var startIdx = (currentPage - 1) * pageSize;
            var endIdx = startIdx + pageSize;
            
            // Mostrar solo las filas de la página activa
            var visibleRowsSlice = filteredRows.slice(startIdx, endIdx);
            visibleRowsSlice.forEach(function(row) {
                row.style.display = "";
            });
            
            // Actualizar textos indicativos
            footerText.textContent = "Mostrando " + visibleRowsSlice.length + " de " + totalRegistros + " registros (Total: " + allRows.length + ")";
            paginadorIndicador.textContent = "Página " + currentPage + " de " + totalPages;
            
            renderPaginador(totalPages);
        }
        
        function renderPaginador(totalPages) {
            paginadorContainer.innerHTML = "";
            
            // Función auxiliar para crear botones
            function crearBoton(texto, destinoPag, deshabilitado, isActive) {
                var btn = document.createElement("button");
                btn.textContent = texto;
                btn.style.padding = "6px 12px";
                btn.style.border = "none";
                btn.style.background = isActive ? "var(--cta-primary)" : "#ffffff";
                btn.style.color = isActive ? "#ffffff" : "var(--cta-text-secondary)";
                btn.style.fontSize = "12px";
                btn.style.fontWeight = isActive ? "600" : "500";
                btn.style.cursor = deshabilitado ? "not-allowed" : "pointer";
                btn.style.borderRadius = "4px";
                btn.style.transition = "background var(--cta-transition)";
                
                if (deshabilitado) {
                    btn.disabled = true;
                    btn.style.opacity = "0.4";
                } else {
                    btn.addEventListener("click", function() {
                        currentPage = destinoPag;
                        renderTabla();
                    });
                    if (!isActive) {
                        btn.onmouseover = function() { btn.style.background = "#f1f5f9"; };
                        btn.onmouseout = function() { btn.style.background = "#ffffff"; };
                    }
                }
                
                paginadorContainer.appendChild(btn);
            }
            
            // Botón Primera
            crearBoton("«", 1, currentPage === 1, false);
            
            // Botón Anterior
            crearBoton("‹", currentPage - 1, currentPage === 1, false);
            
            // Números de Página (Máximo 5 visibles en bloque alrededor de página activa)
            var startPage = Math.max(1, currentPage - 2);
            var endPage = Math.min(totalPages, startPage + 4);
            if (endPage - startPage < 4) {
                startPage = Math.max(1, endPage - 4);
            }
            
            for (var p = startPage; p <= endPage; p++) {
                crearBoton(p, p, false, p === currentPage);
            }
            
            // Botón Siguiente
            crearBoton("›", currentPage + 1, currentPage === totalPages, false);
            
            // Botón Última
            crearBoton("»", totalPages, currentPage === totalPages, false);
        }
        
        // --- 4. ORDENAMIENTO DE COLUMNAS (Client-side) ---
        function aplicarOrdenamiento(cambiarDireccion) {
            if (currentSortCol === null) return;
            
            if (cambiarDireccion) {
                currentSortAsc = !currentSortAsc;
            }
            
            filteredRows.sort(function(rowA, rowB) {
                var valA = obtenerValorCelda(rowA, currentSortCol);
                var valB = obtenerValorCelda(rowB, currentSortCol);
                
                if (typeof valA === "number" && typeof valB === "number") {
                    return currentSortAsc ? valA - valB : valB - valA;
                }
                
                valA = valA.toString().toLowerCase();
                valB = valB.toString().toLowerCase();
                
                if (valA < valB) return currentSortAsc ? -1 : 1;
                if (valA > valB) return currentSortAsc ? 1 : -1;
                return 0;
            });
            
            // Reinsertar las filas en el tbody ordenadas para reflejar el DOM
            filteredRows.forEach(function(row) {
                tableBody.appendChild(row);
            });
            
            actualizarIndicadoresOrdenamiento();
        }
        
        function obtenerValorCelda(row, colIndex) {
            switch(colIndex) {
                case 0: return row.getAttribute("data-numero");
                case 1: return row.getAttribute("data-fecha");
                case 2: return row.getAttribute("data-cliente");
                case 3: return row.getAttribute("data-ruc");
                case 4: return row.getAttribute("data-tipo");
                case 5: return row.getAttribute("data-moneda");
                case 6: return parseFloat(row.getAttribute("data-base")) || 0;
                case 7: return parseFloat(row.getAttribute("data-igv")) || 0;
                case 8: return parseFloat(row.getAttribute("data-total")) || 0;
                case 9: return row.getAttribute("data-estado");
                default: return "";
            }
        }
        
        function actualizarIndicadoresOrdenamiento() {
            var headers = document.querySelectorAll(".sortable-header");
            headers.forEach(function(th) {
                var indicator = th.querySelector(".sort-indicator");
                var colId = parseInt(th.getAttribute("data-column"));
                if (colId === currentSortCol) {
                    indicator.textContent = currentSortAsc ? " ▲" : " ▼";
                    indicator.style.color = "var(--cta-primary)";
                } else {
                    indicator.textContent = "";
                }
            });
        }
        
        // --- 5. EXPORTAR EXCEL/CSV (Visible Rows) ---
        function exportarCSV() {
            if (filteredRows.length === 0) {
                showToast("No hay registros filtrados para exportar.", "warning");
                return;
            }
            
            var csvRows = [];
            // Header
            csvRows.push("Nº Factura,Fecha,Cliente,RUC,Tipo,Moneda,Monto Base,IGV,Total,Estado");
            
            filteredRows.forEach(function(row) {
                var num = row.getAttribute("data-numero");
                var fecha = row.getAttribute("data-fecha");
                var cliente = '"' + row.getAttribute("data-cliente").replace(/"/g, '""') + '"'; // Escapar comillas en csv
                var ruc = row.getAttribute("data-ruc");
                var tipo = row.getAttribute("data-tipo");
                var moneda = row.getAttribute("data-moneda");
                var base = row.getAttribute("data-base");
                var igv = row.getAttribute("data-igv");
                var total = row.getAttribute("data-total");
                var estado = row.getAttribute("data-estado");
                
                csvRows.push([num, fecha, cliente, ruc, tipo, moneda, base, igv, total, estado].join(","));
            });
            
            var csvContent = "\uFEFF" + csvRows.join("\n"); // UTF-8 BOM
            var blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
            var url = URL.createObjectURL(blob);
            
            var link = document.createElement("a");
            link.href = url;
            
            // Generar fecha YYYYMMDD
            var today = new Date();
            var yyyy = today.getFullYear();
            var mm = String(today.getMonth() + 1).padStart(2, '0');
            var dd = String(today.getDate()).padStart(2, '0');
            
            link.download = "facturas_" + yyyy + mm + dd + ".csv";
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
        
        // --- 2. MODAL DE DETALLE FISCAL (Carga vía AJAX con Asiento Contable) ---
        function abrirModalDetalle(row) {
            var id = row.getAttribute("data-id");
            var cdrProcesado = row.getAttribute("data-cdr-procesado") === "true";
            
            // Guardar el ID de la factura para el procesamiento del CDR
            var cdrBtn = document.getElementById("modal-cdr-btn");
            if (cdrBtn) {
                cdrBtn.setAttribute("data-factura-id", id);
                if (cdrProcesado) {
                    cdrBtn.style.display = "none";
                } else {
                    cdrBtn.style.display = "inline-flex";
                }
            }
            
            // Poner cargando en la tabla de asiento
            var asientoBody = document.getElementById("modal-asiento-lineas-body");
            asientoBody.innerHTML = `<tr><td colspan="5" style="padding: 20px; text-align: center; color: var(--cta-text-secondary);">
                <div style="display: inline-flex; align-items: center; gap: 8px;">
                    <svg style="animation: spin 1s linear infinite; width: 20px; height: 20px; color: #4f46e5;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle style="opacity: 0.25;" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path style="opacity: 0.75;" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    Cargando información contable...
                </div>
            </td></tr>`;
            
            // Mostrar Modal primero
            modal.style.display = "flex";

            // Hacer fetch de detalles
            fetch(`/Facturas/GetDetalle?id=${encodeURIComponent(id)}`)
                .then(function(res) {
                    if (!res.ok) throw new Error("No se pudo obtener el detalle.");
                    return res.json();
                })
                .then(function(data) {
                    var header = data.header || data.Header;
                    var lines = data.lines || data.Lines;
                    
                    var symbol = (header.MonedaSimbolo || header.monedaSimbolo || "$");
                    var currency = (header.Moneda || header.moneda || "PEN");
                    var numeroFactura = (header.NumeroFactura || header.numeroFactura || "");
                    var tipoComprobante = (header.TipoComprobante || header.tipoComprobante || "Factura");
                    var cliente = (header.Cliente || header.cliente || "Cliente");
                    var ruc = (header.RUC || header.ruc || "--");
                    var fecha = (header.Fecha || header.fecha || "");
                    var fechaVencimiento = (header.FechaVencimiento || header.fechaVencimiento || "");
                    var referencia = (header.Referencia || header.referencia || "--");
                    var diario = (header.Diario || header.diario || "Diario de Ventas");
                    var tipoCambio = (header.TipoCambio || header.tipoCambio || 1.0);
                    var montoPendiente = (header.MontoPendiente || header.montoPendiente || 0);
                    var narracion = (header.Narracion || header.narracion || "");
                    var baseVal = (header.MontoBase || header.montoBase || 0);
                    var igvVal = (header.IGV || header.igv || 0);
                    var totalVal = (header.Total || header.total || 0);
                    var estadoVal = (header.Estado || header.estado || "");
                    
                    // Cargar datos en Modal
                    document.getElementById("modal-comprobante-num").textContent = numeroFactura;
                    document.getElementById("modal-comprobante-tipo").textContent = tipoComprobante + " Electrónica";
                    document.getElementById("modal-cliente-nombre").textContent = cliente;
                    document.getElementById("modal-cliente-ruc").textContent = ruc;
                    document.getElementById("modal-comprobante-fecha").textContent = fecha ? fecha.split("-").reverse().join("/") : "--";
                    document.getElementById("modal-moneda-label").textContent = currency;
                    
                    // Nuevos campos
                    document.getElementById("modal-comprobante-vencimiento").textContent = fechaVencimiento ? fechaVencimiento.split("-").reverse().join("/") : "--";
                    document.getElementById("modal-referencia").textContent = referencia;
                    document.getElementById("modal-diario-contable").textContent = diario;
                    document.getElementById("modal-tipo-cambio").textContent = parseFloat(tipoCambio).toFixed(4);
                    document.getElementById("modal-monto-pendiente").textContent = symbol + " " + formatNumber(montoPendiente);

                    // Notas/Narración
                    var narracionContainer = document.getElementById("modal-narracion-container");
                    var narracionText = document.getElementById("modal-narracion");
                    if (narracion && narracion.trim() !== "") {
                        narracionText.textContent = narracion;
                        narracionContainer.style.display = "block";
                    } else {
                        narracionContainer.style.display = "none";
                    }

                    // Montos fiscales en desglose
                    var base = parseFloat(baseVal) || 0;
                    var igv = parseFloat(igvVal) || 0;
                    var total = parseFloat(totalVal) || 0;
                    document.getElementById("modal-base-val").textContent = currency + " " + formatNumber(base);
                    document.getElementById("modal-base-subtotal").textContent = currency + " " + formatNumber(base);
                    document.getElementById("modal-igv-subtotal").textContent = currency + " " + formatNumber(igv);
                    document.getElementById("modal-total-subtotal").textContent = currency + " " + formatNumber(total);
                    
                    // Badge Estado
                    var badgeContainer = document.getElementById("modal-comprobante-estado");
                    badgeContainer.innerHTML = "";
                    var badgeSpan = document.createElement("span");
                    badgeSpan.textContent = estadoVal;
                    badgeSpan.style.padding = "4px 12px";
                    badgeSpan.style.borderRadius = "9999px";
                    badgeSpan.style.fontSize = "11.5px";
                    badgeSpan.style.fontWeight = "600";
                    
                    if (estadoVal === "Emitida") {
                        badgeSpan.style.background = "rgba(16, 185, 129, 0.12)";
                        badgeSpan.style.color = "#10b981";
                        badgeSpan.style.border = "1px solid rgba(16, 185, 129, 0.2)";
                    } else if (estadoVal === "Enviada") {
                        badgeSpan.style.background = "rgba(59, 130, 246, 0.12)";
                        badgeSpan.style.color = "#2563eb";
                        badgeSpan.style.border = "1px solid rgba(59, 130, 246, 0.2)";
                    } else if (estadoVal === "Anulada") {
                        badgeSpan.style.background = "rgba(239, 68, 68, 0.12)";
                        badgeSpan.style.color = "#ef4444";
                        badgeSpan.style.border = "1px solid rgba(239, 68, 68, 0.2)";
                    } else {
                        badgeSpan.style.background = "rgba(245, 158, 11, 0.12)";
                        badgeSpan.style.color = "#f59e0b";
                        badgeSpan.style.border = "1px solid rgba(245, 158, 11, 0.2)";
                    }
                    badgeContainer.appendChild(badgeSpan);

                    // Renderizar líneas de Asiento Contable
                    asientoBody.innerHTML = "";
                    var totalDebe = 0;
                    var totalHaber = 0;

                    if (lines && lines.length > 0) {
                        lines.forEach(function(line) {
                            var cuentaCodigo = (line.CuentaCodigo || line.cuentaCodigo || "");
                            var cuentaNombre = (line.CuentaNombre || line.cuentaNombre || "");
                            var descripcion = (line.Descripcion || line.descripcion || "--");
                            var debeVal = parseFloat(line.Debe || line.debe) || 0;
                            var haberVal = parseFloat(line.Haber || line.haber) || 0;
                            totalDebe += debeVal;
                            totalHaber += haberVal;

                            var tr = document.createElement("tr");
                            tr.style.borderBottom = "1px solid var(--cta-border)";
                            
                            tr.innerHTML = `
                                <td style="padding: 10px 14px; font-family: monospace; font-weight: bold; color: var(--cta-primary);">${cuentaCodigo}</td>
                                <td style="padding: 10px 14px; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${cuentaNombre}">${cuentaNombre}</td>
                                <td style="padding: 10px 14px; max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${descripcion}">${descripcion}</td>
                                <td style="padding: 10px 14px; text-align: right; font-family: monospace;">${debeVal > 0 ? formatNumber(debeVal) : "-"}</td>
                                <td style="padding: 10px 14px; text-align: right; font-family: monospace;">${haberVal > 0 ? formatNumber(haberVal) : "-"}</td>
                            `;
                            asientoBody.appendChild(tr);
                        });
                    } else {
                        asientoBody.innerHTML = `<tr><td colspan="5" style="padding: 20px; text-align: center; color: var(--cta-text-secondary);">No se encontraron líneas contables asociadas.</td></tr>`;
                    }

                    document.getElementById("modal-asiento-debe-tot").textContent = formatNumber(totalDebe);
                    document.getElementById("modal-asiento-haber-tot").textContent = formatNumber(totalHaber);
                })
                .catch(function(err) {
                    console.error(err);
                    asientoBody.innerHTML = `<tr><td colspan="5" style="padding: 20px; text-align: center; color: #ef4444; font-weight: 600;">Error al cargar detalles contables.</td></tr>`;
                });
        }
        
        function cerrarModal() {
            modal.style.display = "none";
        }
        
        // --- VINCULACIÓN DE EVENTOS ---
        
        // Ejecutar filtrado
        btnFiltrar.addEventListener("click", aplicarFiltros);
        
        // Pestañas CDR
        var tabPendientes = document.getElementById("tab-pendientes");
        var tabEnviadas = document.getElementById("tab-enviadas");
        if (tabPendientes && tabEnviadas) {
