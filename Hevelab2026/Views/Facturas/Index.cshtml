            <button id="modal-cerrar-btn" style="border: 1px solid var(--cta-border); background: #ffffff; color: var(--cta-text-secondary); padding: 8px 16px; border-radius: 6px; font-size: 12.5px; font-weight: 500; cursor: pointer; transition: background var(--cta-transition);" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='#ffffff'">Cerrar</button>
            <button id="modal-imprimir-btn" style="background: var(--cta-primary); color: #ffffff; border: none; padding: 8px 16px; border-radius: 6px; font-size: 12.5px; font-weight: 600; cursor: pointer; transition: background var(--cta-transition);" onmouseover="this.style.background='var(--cta-primary-hover)'" onmouseout="this.style.background='var(--cta-primary)'">Imprimir</button>
        </div>

    </div>
</div>

<!-- Modal de Crear / Editar Comprobante -->
<div id="formulario-modal" style="display: none; position: fixed; inset: 0; background: rgba(30, 41, 59, 0.45); backdrop-filter: blur(4px); z-index: 200; align-items: flex-start; justify-content: center; overflow-y: auto; padding: 40px 16px; box-sizing: border-box; animation: modalFadeIn 250ms ease-out;">
    <div style="background: #ffffff; border-radius: var(--cta-radius); max-width: 550px; width: 100%; box-shadow: var(--cta-shadow-md); border: 1px solid var(--cta-border); display: flex; flex-direction: column; overflow: hidden; margin: 0 auto;">
        
        <!-- Header -->
        <div style="padding: 16px 24px; border-bottom: 1px solid var(--cta-border); display: flex; justify-content: space-between; align-items: center; background: #f8fafc;">
            <h3 id="modal-form-title" style="margin: 0; font-size: 15px; font-weight: 700; color: var(--cta-text-primary); display: flex; align-items: center; gap: 8px;">
                <svg viewBox="0 0 24 24" style="width: 16px; height: 16px; fill: none; stroke: var(--cta-primary); stroke-width: 2.5;">
                    <path d="M12 20h9"></path>
                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                </svg>
                Nuevo Comprobante
            </h3>
            <button id="modal-form-cerrar-x" style="background: none; border: none; font-size: 22px; color: var(--cta-text-muted); cursor: pointer; transition: color var(--cta-transition);">&times;</button>
        </div>

        <form method="post" asp-action="GuardarFactura" id="factura-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="originalNumero" id="form-original-numero" />
            
            <!-- Body -->
            <div style="padding: 24px; display: flex; flex-direction: column; gap: 16px;">
                
                <!-- RUC & Razon Social -->
                <div style="display: grid; grid-template-columns: 1fr; gap: 12px;">
                    <div>
                        <label for="form-ruc" style="display: block; font-size: 12px; font-weight: 600; color: var(--cta-text-secondary); margin-bottom: 4px;">RUC Cliente</label>
                        <input type="text" name="ruc" id="form-ruc" required placeholder="Escriba RUC o DNI..." style="width: 100%; padding: 8px 12px; border: 1px solid var(--cta-border); border-radius: 6px; font-size: 13px;" list="socios-list" />
                        <datalist id="socios-list">
                            @if (ViewBag.Socios != null)
                            {
                                foreach (var s in ViewBag.Socios)
                                {
                                    <option value="@s.numero_documento">@s.razon_social</option>
                                }
                            }
                        </datalist>
                    </div>
                    <div>
                        <label for="form-cliente" style="display: block; font-size: 12px; font-weight: 600; color: var(--cta-text-secondary); margin-bottom: 4px;">Razón Social / Cliente</label>
                        <input type="text" name="razonSocial" id="form-cliente" required placeholder="Nombre del cliente..." style="width: 100%; padding: 8px 12px; border: 1px solid var(--cta-border); border-radius: 6px; font-size: 13px;" />
                    </div>
                </div>

                <!-- Tipo Comprobante & Numero & Fecha -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div>
                        <label for="form-tipo" style="display: block; font-size: 12px; font-weight: 600; color: var(--cta-text-secondary); margin-bottom: 4px;">Tipo de Comprobante</label>
                        <select name="tipoComprobante" id="form-tipo" style="width: 100%; padding: 8px 10px; border: 1px solid var(--cta-border); border-radius: 6px; font-size: 13px;">
                            <option value="Factura">Factura</option>
                            <option value="Boleta">Boleta</option>
                            <option value="Nota de Crédito">Nota de Crédito</option>
                        </select>
                    </div>
                    <div>
                        <label for="form-numero" style="display: block; font-size: 12px; font-weight: 600; color: var(--cta-text-secondary); margin-bottom: 4px;">Número Comprobante</label>
                        <input type="text" name="numeroFactura" id="form-numero" required placeholder="F001-0000001" style="width: 100%; padding: 8px 12px; border: 1px solid var(--cta-border); border-radius: 6px; font-size: 13px;" />
                    </div>
                </div>

                <!-- Fecha & Moneda & Estado -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div>
                        <label for="form-fecha" style="display: block; font-size: 12px; font-weight: 600; color: var(--cta-text-secondary); margin-bottom: 4px;">Fecha Emisión</label>
                        <input type="date" name="fecha" id="form-fecha" required style="width: 100%; padding: 7px 10px; border: 1px solid var(--cta-border); border-radius: 6px; font-size: 13px;" />
                    </div>
                    <div>
                        <label for="form-moneda" style="display: block; font-size: 12px; font-weight: 600; color: var(--cta-text-secondary); margin-bottom: 4px;">Moneda</label>
                        <select name="moneda" id="form-moneda" style="width: 100%; padding: 8px 10px; border: 1px solid var(--cta-border); border-radius: 6px; font-size: 13px;">
                            <option value="PEN">PEN (Sol)</option>
                            <option value="USD">USD (Dólar)</option>
                        </select>
                    </div>
                </div>

                <!-- Monto Base & IGV & Total -->
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px;">
                    <div>
                        <label for="form-base" style="display: block; font-size: 12px; font-weight: 600; color: var(--cta-text-secondary); margin-bottom: 4px;">Monto Base</label>
                        <input type="number" step="0.01" name="montoBase" id="form-base" required value="0.00" style="width: 100%; padding: 8px 12px; border: 1px solid var(--cta-border); border-radius: 6px; font-size: 13px; text-align: right;" />
                    </div>
                    <div>
                        <label for="form-igv" style="display: block; font-size: 12px; font-weight: 600; color: var(--cta-text-secondary); margin-bottom: 4px;">IGV (18%)</label>
                        <input type="number" step="0.01" name="igv" id="form-igv" required value="0.00" style="width: 100%; padding: 8px 12px; border: 1px solid var(--cta-border); border-radius: 6px; font-size: 13px; text-align: right;" />
                    </div>
                    <div>
                        <label for="form-total" style="display: block; font-size: 12px; font-weight: 600; color: var(--cta-text-secondary); margin-bottom: 4px;">Total</label>
                        <input type="number" step="0.01" name="total" id="form-total" required value="0.00" style="width: 100%; padding: 8px 12px; border: 1px solid var(--cta-border); border-radius: 6px; font-size: 13px; text-align: right; font-weight: 600;" />
                    </div>
                </div>

                <!-- Estado -->
                <div>
                    <label for="form-estado" style="display: block; font-size: 12px; font-weight: 600; color: var(--cta-text-secondary); margin-bottom: 4px;">Estado</label>
                    <select name="estado" id="form-estado" style="width: 100%; padding: 8px 10px; border: 1px solid var(--cta-border); border-radius: 6px; font-size: 13px;">
                        <option value="Emitida">Emitida</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Anulada">Anulada</option>
                    </select>
                </div>

            </div>

            <!-- Footer -->
            <div style="padding: 16px 24px; border-top: 1px solid var(--cta-border); display: flex; justify-content: flex-end; gap: 8px; background: #f8fafc;">
                <button type="button" id="modal-form-cancelar-btn" style="border: 1px solid var(--cta-border); background: #ffffff; color: var(--cta-text-secondary); padding: 8px 16px; border-radius: 6px; font-size: 12.5px; font-weight: 500; cursor: pointer;">Cancelar</button>
                <button type="submit" style="background: var(--cta-primary); color: #ffffff; border: none; padding: 8px 16px; border-radius: 6px; font-size: 12.5px; font-weight: 600; cursor: pointer;">Guardar</button>
            </div>
        </form>

    </div>
</div>

<!-- Estilos CSS complementarios -->
<style>
    @@keyframes ctaFadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    @@keyframes modalFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    
    .factura-row:hover {
        background-color: #f8fafc !important;
    }

    .cta-action-btn:hover {
        background-color: var(--cta-primary-soft) !important;
        border-color: var(--cta-primary) !important;
        color: var(--cta-primary) !important;
    }

    .sortable-header:hover {
        background-color: #e0e7ff !important;
    }

    @@keyframes toastSlideIn {
        from {
            transform: translateX(120%) scale(0.9);
            opacity: 0;
        }
        to {
            transform: translateX(0) scale(1);
            opacity: 1;
        }
    }

    @@keyframes toastSlideOut {
        from {
            transform: translateX(0) scale(1);
            opacity: 1;
