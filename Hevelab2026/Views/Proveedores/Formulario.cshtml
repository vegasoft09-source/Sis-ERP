@model Hevelab2026.Models.Compras.ProveedorFormModel
@{
    ViewData["Title"] = "Registrar Proveedor";
}

<div class="w-full h-full bg-slate-50/50 p-2 md:p-6 antialiased">
    <div class="w-full bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        
        <!-- Header -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
            <div class="flex items-center gap-3">
                <a href="/Proveedores" class="text-slate-400 hover:text-slate-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                </a>
                <h2 class="text-lg font-bold text-[#4c3ce4]">Registrar Proveedor</h2>
            </div>
            <a href="/Proveedores" class="text-slate-400 hover:text-slate-600 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </a>
        </div>

        <form method="post" class="p-6 md:p-8" novalidate>
            @Html.AntiForgeryToken()

            <!-- Top Section -->
            <div class="flex flex-col md:flex-row gap-10">
                
                <!-- Left Column (Photo) -->
                <div class="flex flex-col items-center gap-3 md:w-48 shrink-0">
                    <div class="w-32 h-32 rounded-full border-2 border-dashed border-slate-200 flex items-center justify-center bg-slate-50 text-slate-300">
                        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    </div>
                    <button type="button" class="text-[10px] font-bold text-[#4c3ce4] uppercase tracking-wider hover:underline">AGREGAR UNA FOTOGRAFÍA</button>
                </div>

                <!-- Right Column (Fields) -->
                <div class="flex-1 space-y-6">
                    


                    <!-- Row 1 -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
                        <div class="md:col-span-2">
                            <label asp-for="RazonSocial" class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Nombre Completo / Razón Social</label>
                            <input asp-for="RazonSocial" class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800" placeholder="Ej. Juan Pérez" />
                            <span asp-validation-for="RazonSocial" class="text-red-500 text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="Email" class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Correo Electrónico</label>
                            <input asp-for="Email" class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800" placeholder="nombre@empresa.com" />
                            <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Puesto de trabajo</label>
                            <input type="text" class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800" placeholder="Ej. Gerente" />
                        </div>

                        <!-- ID Number with selector -->
                        <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
                            <div>
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5 flex items-center gap-1">
                                    Número de Identificación
                                    <svg class="w-3 h-3 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4m0-4h.01" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                                </label>
                                <div class="flex">
                                    <div class="w-24 px-3 py-2 text-sm bg-slate-50/50 border border-r-0 border-slate-200 rounded-l-lg flex items-center justify-center font-bold text-slate-700 select-none">
                                        RUC
                                        <input type="hidden" asp-for="TipoDocumento" value="RUC" />
                                    </div>
                                    <input asp-for="NumeroDocumento" class="flex-1 px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-r-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800" placeholder="Número..." />
                                </div>
                                <span asp-validation-for="NumeroDocumento" class="text-red-500 text-xs mt-1 block"></span>
                            </div>

                            <div>
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Grupo Proveedor</label>
                                <select class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800 appearance-none bg-no-repeat bg-[right_0.5rem_center] bg-[length:1em_1em]" style="background-image: url('data:image/svg+xml;charset=UTF-8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'%2364748b\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><polyline points=\'6 9 12 15 18 9\'></polyline></svg>');">
                                    <option>Seleccionar...</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Grupo Proveedores</label>
                            <select class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800 appearance-none bg-no-repeat bg-[right_0.5rem_center] bg-[length:1em_1em]" style="background-image: url('data:image/svg+xml;charset=UTF-8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'%2364748b\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><polyline points=\'6 9 12 15 18 9\'></polyline></svg>');">
                                <option>Seleccionar...</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Código</label>
                            <input type="text" class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800" placeholder="Cod-001" />
                        </div>
                    </div>

                </div>
            </div>

            <!-- Separator -->
            <hr class="my-8 border-slate-100" />

            <!-- Dirección de entrega -->
            <div class="mb-8">
                <h3 class="flex items-center gap-2 text-[#4c3ce4] font-extrabold uppercase tracking-wider text-xs mb-5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    Dirección de entrega
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div class="md:col-span-2">
                        <label asp-for="Direccion" class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Dirección</label>
                        <input asp-for="Direccion" class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Distrito</label>
                        <input type="text" class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800" />
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Provincia</label>
                        <input type="text" class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Zip</label>
                        <input type="text" class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800" />
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">País</label>
                        <select class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800 appearance-none bg-no-repeat bg-[right_0.5rem_center] bg-[length:1em_1em]" style="background-image: url('data:image/svg+xml;charset=UTF-8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'%2364748b\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><polyline points=\'6 9 12 15 18 9\'></polyline></svg>');">
                            <option>Perú</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Tabs Navigation -->
            <div class="border-b border-slate-200 mb-6 flex overflow-x-auto">
                <nav class="flex gap-8" id="proveedor-tabs" aria-label="Tabs">
                    <button type="button" class="tab-btn border-b-2 border-[#4c3ce4] text-[#4c3ce4] py-3 px-1 text-xs font-bold whitespace-nowrap" data-target="tab-contactos">Contactos</button>
                    <button type="button" class="tab-btn border-b-2 border-transparent text-slate-400 hover:text-slate-600 hover:border-slate-300 py-3 px-1 text-xs font-bold whitespace-nowrap transition-colors" data-target="tab-compras">Compras</button>
                    <button type="button" class="tab-btn border-b-2 border-transparent text-slate-400 hover:text-slate-600 hover:border-slate-300 py-3 px-1 text-xs font-bold whitespace-nowrap transition-colors" data-target="tab-contabilidad">Contabilidad</button>
                    <button type="button" class="tab-btn border-b-2 border-transparent text-slate-400 hover:text-slate-600 hover:border-slate-300 py-3 px-1 text-xs font-bold whitespace-nowrap transition-colors" data-target="tab-asignacion">Asignación de socio</button>
                    <button type="button" class="tab-btn border-b-2 border-transparent text-slate-400 hover:text-slate-600 hover:border-slate-300 py-3 px-1 text-xs font-bold whitespace-nowrap transition-colors" data-target="tab-notas">Notas</button>
                </nav>
            </div>

            <!-- Tab Content: Contactos -->
            <div id="tab-contactos" class="tab-content block space-y-4">
                <div class="border border-slate-200 rounded-xl overflow-hidden bg-white">
                    <div class="bg-[#f1f5f9] px-4 py-3 flex items-center text-[10px] font-bold text-[#64748b] uppercase tracking-wider">
                        <div class="w-12">ID</div>
                        <div class="flex-1">NOMBRE</div>
                        <div class="flex-1">RAZÓN SOCIAL</div>
                        <div class="flex-1">DISTRITO</div>
                        <div class="flex-1">CORREO ELECTRÓ...</div>
                        <div class="w-32">TELÉFONO</div>
                        <div class="flex-1">ACTIVIDADES</div>
                        <div class="w-24">PAÍS</div>
                    </div>
                    <div class="py-14 flex items-center justify-center text-[#cbd5e1] text-sm font-semibold italic">
                        No hay contactos registrados
                    </div>
                    <div class="border-t border-slate-200 px-4 py-3 bg-white">
                        <button id="btn-agregar-contacto" type="button" class="flex items-center gap-1.5 text-[#4c3ce4] text-xs font-bold uppercase tracking-wide hover:underline">
                            <div class="border border-[#4c3ce4] rounded-full p-0.5"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4"></path></svg></div>
                            AGREGAR CONTACTO
                        </button>
                    </div>
                </div>
            </div>

            <!-- Tab Content: Compras -->
            <div id="tab-compras" class="tab-content hidden">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
                    
                    <!-- Left: Bloque Compras & Punto de Venta -->
                    <div class="space-y-8">
                        <div>
                            <h4 class="flex items-center gap-2 text-slate-600 font-extrabold uppercase tracking-wider text-[10px] mb-4">
                                <svg class="w-4 h-4 text-[#4c3ce4]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                                BLOQUE COMPRAS
                            </h4>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Comprador Asignado</label>
                                    <select class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800 appearance-none bg-no-repeat bg-[right_0.5rem_center] bg-[length:1em_1em]" style="background-image: url('data:image/svg+xml;charset=UTF-8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'%2364748b\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><polyline points=\'6 9 12 15 18 9\'></polyline></svg>');">
                                        <option>Seleccionar...</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Condiciones de pago</label>
                                    <select class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800 appearance-none bg-no-repeat bg-[right_0.5rem_center] bg-[length:1em_1em]" style="background-image: url('data:image/svg+xml;charset=UTF-8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'%2364748b\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><polyline points=\'6 9 12 15 18 9\'></polyline></svg>');">
                                        <option>45 días netos</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Método de pago</label>
                                    <input type="text" class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800" placeholder="Ejem: Transferencia Bancaria" />
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Lista de precios (proveedor)</label>
                                    <select class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800 appearance-none bg-no-repeat bg-[right_0.5rem_center] bg-[length:1em_1em]" style="background-image: url('data:image/svg+xml;charset=UTF-8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'%2364748b\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><polyline points=\'6 9 12 15 18 9\'></polyline></svg>');">
                                        <option>Tarifa Distribuidor</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div>
                            <h4 class="flex items-center gap-2 text-slate-600 font-extrabold uppercase tracking-wider text-[10px] mb-4">
                                <svg class="w-4 h-4 text-[#4c3ce4]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path></svg>
                                BLOQUE PUNTO DE VENTA
                            </h4>
                            <div>
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Código de barras</label>
                                <div class="relative">
                                    <input type="text" class="w-full pl-3 pr-10 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800" value="775849302111" />
                                    <div class="absolute right-3 top-1/2 -translate-y-1/2 flex gap-[2px]">
                                        <div class="w-0.5 h-3.5 bg-slate-400"></div><div class="w-0.5 h-3.5 bg-slate-400"></div><div class="w-1 h-3.5 bg-slate-400"></div><div class="w-0.5 h-3.5 bg-slate-400"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Bloque Información Fiscal & Varios -->
                    <div class="space-y-8">
                        <div>
                            <h4 class="flex items-center gap-2 text-slate-600 font-extrabold uppercase tracking-wider text-[10px] mb-4">
                                <svg class="w-4 h-4 text-[#4c3ce4]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                                BLOQUE INFORMACIÓN FISCAL
                            </h4>
                            <div>
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Posición fiscal</label>
                                <select class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800 appearance-none bg-no-repeat bg-[right_0.5rem_center] bg-[length:1em_1em]" style="background-image: url('data:image/svg+xml;charset=UTF-8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'%2364748b\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><polyline points=\'6 9 12 15 18 9\'></polyline></svg>');">
                                    <option>Régimen General</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <h4 class="flex items-center gap-2 text-slate-600 font-extrabold uppercase tracking-wider text-[10px] mb-4">
                                <span class="text-[#4c3ce4] font-bold text-sm leading-none mr-1">...</span>
                                BLOQUE VARIOS
                            </h4>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Referencia interna</label>
                                    <input type="text" class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800" placeholder="Referencia interna del proveedor" />
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Políticas de entrega</label>
                                    <select class="w-full px-3 py-2 text-sm bg-slate-50/50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4c3ce4]/20 focus:border-[#4c3ce4] transition-colors font-semibold text-slate-800 appearance-none bg-no-repeat bg-[right_0.5rem_center] bg-[length:1em_1em]" style="background-image: url('data:image/svg+xml;charset=UTF-8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'%2364748b\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><polyline points=\'6 9 12 15 18 9\'></polyline></svg>');">
                                        <option>Puerta a puerta</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Tab Content: Contabilidad -->
