@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const tabBtns = document.querySelectorAll('.tab-btn');
            const tabContents = document.querySelectorAll('.tab-content');

            tabBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    // Reset all buttons
                    tabBtns.forEach(b => {
                        b.classList.remove('border-[#4c3ce4]', 'text-[#4c3ce4]');
                        b.classList.add('border-transparent', 'text-slate-400');
                    });
                    
                    // Activate clicked button
                    btn.classList.remove('border-transparent', 'text-slate-400');
                    btn.classList.add('border-[#4c3ce4]', 'text-[#4c3ce4]');

                    // Hide all contents
                    tabContents.forEach(content => {
                        content.classList.add('hidden');
                        content.classList.remove('block');
                    });

                    // Show target content
                    const targetId = btn.getAttribute('data-target');
                    const targetContent = document.getElementById(targetId);
                    if (targetContent) {
                        targetContent.classList.remove('hidden');
                        targetContent.classList.add('block');
                    }
                });
            });

            // Modal Contacto Logic
            const btnAgregarContacto = document.getElementById('btn-agregar-contacto');
            const modalContacto = document.getElementById('modal-contacto');
            const btnsCerrarModal = document.querySelectorAll('.btn-cerrar-modal');
            const backdrop = document.getElementById('modal-contacto-backdrop');

            function openModal() {
                modalContacto.classList.remove('hidden');
            }

            function closeModal() {
                modalContacto.classList.add('hidden');
            }

            if(btnAgregarContacto) {
                btnAgregarContacto.addEventListener('click', openModal);
            }

            btnsCerrarModal.forEach(btn => {
                btn.addEventListener('click', closeModal);
            });

            if(backdrop) {
                backdrop.addEventListener('click', closeModal);
            }

            // Logic for Contacto Modal Type Switch
            const radioContactoPersona = document.getElementById('radio-contacto-persona');
            const radioContactoEmpresa = document.getElementById('radio-contacto-empresa');
            const labelContactoPersona = document.getElementById('label-contacto-persona');
            const labelContactoEmpresa = document.getElementById('label-contacto-empresa');
            const lblContactoNombre = document.getElementById('lbl-contacto-nombre');
            const inputContactoNombre = document.getElementById('input-contacto-nombre');
            const inputContactoDocumento = document.getElementById('input-contacto-documento');

            function updateContactoType() {
                if(radioContactoPersona && radioContactoPersona.checked) {
                    labelContactoPersona.classList.replace('text-slate-400', 'text-slate-700');
                    labelContactoEmpresa.classList.replace('text-slate-700', 'text-slate-400');
                    
                    lblContactoNombre.textContent = "Nombre Completo";
                    inputContactoNombre.placeholder = "Ej. Juan Pérez";
                    inputContactoDocumento.placeholder = "DNI";
                } else if(radioContactoEmpresa && radioContactoEmpresa.checked) {
                    labelContactoEmpresa.classList.replace('text-slate-400', 'text-slate-700');
                    labelContactoPersona.classList.replace('text-slate-700', 'text-slate-400');
                    
                    lblContactoNombre.textContent = "Razón Social";
                    inputContactoNombre.placeholder = "Ej. Mi Empresa S.A.C.";
                    inputContactoDocumento.placeholder = "RUC";
                }
            }

            if(radioContactoPersona) radioContactoPersona.addEventListener('change', updateContactoType);
            if(radioContactoEmpresa) radioContactoEmpresa.addEventListener('change', updateContactoType);
            
            // initialize
            updateContactoType();

            // Logic for Map
            const inputLat = document.getElementById('input-latitud');
            const inputLng = document.getElementById('input-longitud');
            const btnActualizarMapa = document.getElementById('btn-actualizar-mapa');
            const mapaContainer = document.getElementById('mapa-container');

            if(btnActualizarMapa && inputLat && inputLng && mapaContainer) {
                btnActualizarMapa.addEventListener('click', () => {
                    const lat = parseFloat(inputLat.value);
                    const lng = parseFloat(inputLng.value);

                    if(!isNaN(lat) && !isNaN(lng)) {
                        const src = `https://www.openstreetmap.org/export/embed.html?bbox=${lng-0.005}%2C${lat-0.005}%2C${lng+0.005}%2C${lat+0.005}&layer=mapnik&marker=${lat}%2C${lng}`;
                        mapaContainer.innerHTML = `<iframe width="100%" height="100%" frameborder="0" scrolling="no" marginheight="0" marginwidth="0" src="${src}" style="border:0"></iframe>`;
                    } else {
                        mapaContainer.innerHTML = `<span class="text-slate-400 text-sm font-semibold italic">Coordenadas inválidas</span>`;
                    }
                });
            }
        });
    </script>
}
