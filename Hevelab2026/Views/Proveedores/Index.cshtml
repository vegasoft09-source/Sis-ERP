@{
    ViewData["Title"] = "Proveedores";
}

<div class="w-full space-y-6 text-slate-800 antialiased">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h3 class="text-xl font-bold tracking-tight text-slate-900">Proveedores</h3>
            <p class="text-xs text-slate-500 mt-0.5">Gestiona y realiza seguimiento a tus proveedores y cadena de suministro.</p>
        </div>
        <div>
            <a href="/Proveedores/Formulario" class="inline-flex items-center justify-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 rounded-xl shadow-sm transition-colors duration-200">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Nuevo
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">@TempData["Success"]</div>
    }

    <div class="p-4 bg-white border border-slate-100 rounded-2xl shadow-sm">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
            <div class="md:col-span-7">
                <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">Buscar Proveedores</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 pointer-events-none">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input type="text" placeholder="Buscar por nombre, RUC o correo..." class="w-full pl-9 pr-4 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 focus:bg-white transition-all text-slate-600" />
                </div>
            </div>
            <div class="md:col-span-3">
                <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">Fecha</label>
                <input type="date" class="w-full px-3 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 focus:bg-white transition-all text-slate-500" style="height: 34px;" />
            </div>
            <div class="md:col-span-2">
                <button class="w-full py-2 text-[11px] font-bold uppercase tracking-wider bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl border border-slate-200 shadow-sm transition-all">Aplicar Filtros</button>
            </div>
        </div>
    </div>

    <div class="bg-white border border-slate-100 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
                <thead class="bg-slate-50/70 text-[10px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100">
                    <tr>
                        <th class="pl-6 py-3.5">Nombre / Razón Social</th>
                        <th class="py-3.5">RUC</th>
                        <th class="py-3.5">Dirección</th>
                        <th class="py-3.5">Teléfono</th>
                        <th class="py-3.5">Correo Electrónico</th>
                        <th class="py-3.5">Estado</th>
                        <th class="text-center pr-6 py-3.5">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-600">
                    @{
                        var proveedores = ViewBag.Proveedores as IEnumerable<Hevelab2026.Services.Compras.ProveedorVm>
                            ?? Enumerable.Empty<Hevelab2026.Services.Compras.ProveedorVm>();
                    }
                    @foreach (var p in proveedores)
                    {
                    <tr class="hover:bg-slate-50/40 transition-colors">
                        <td class="pl-6 py-3.5">
                            <div class="font-bold text-slate-900">@p.RazonSocial</div>
                            <span class="inline-block text-[9px] font-semibold tracking-wide text-slate-400 uppercase mt-0.5">@p.Codigo</span>
                        </td>
                        <td class="font-mono text-slate-600 font-semibold">@p.Ruc</td>
                        <td class="text-slate-500">—</td>
                        <td class="text-slate-500">@(p.Telefono ?? "—")</td>
                        <td>@(string.IsNullOrEmpty(p.Email) ? "—" : p.Email)</td>
                        <td>
                            <span class="inline-flex items-center px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide rounded-full @(p.Activo ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-slate-100 text-slate-500")">@(p.Activo ? "ACTIVO" : "INACTIVO")</span>
                        </td>
                        <td class="text-center pr-6">—</td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-6 py-3 bg-slate-50/50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <div>Mostrando <span class="font-semibold text-slate-700">@proveedores.Count()</span> proveedores.</div>
        </div>
    </div>
</div>