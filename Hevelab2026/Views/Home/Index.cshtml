@model Hevelab2026.Models.DashboardViewModel
@using Hevelab2026.Models.Modulos
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    var categorias = ModuloCategoria.Filtros;
    var totalModulos = ModuloRegistry.Total;
    var nombreUsuario = User.Identity?.Name ?? "Usuario";
    var metricsChartsJson = JsonSerializer.Serialize(
        Model.Metrics.Select(m => new { m.Chart.Type, m.Chart.Labels, m.Chart.Values, m.ThemeColor }),
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

<div class="container-fluid p-0 animate-fade-in">
    <!-- Header -->
    <header class="hl-dash-header mb-4">
        <div class="hl-dash-header-text">
            <h1 class="hl-dash-greeting">Bienvenido, @nombreUsuario</h1>
            <p class="hl-dash-subtitle">Resumen ejecutivo y accesos rápidos de HeveLab ERP.</p>
        </div>
        <span class="hl-dash-pill hl-dash-pill--status">
            <span class="hl-dash-status-dot" aria-hidden="true"></span>
            Conectado a Producción
        </span>
    </header>

    <!-- KPI cards -->
    <div class="row g-3 mb-4">
        @for (var mi = 0; mi < Model.Metrics.Count; mi++)
        {
            var metric = Model.Metrics[mi];
            <div class="col-12 col-sm-6 col-xxl-3">
                <article class="hl-kpi-card hl-metric-card">
                    <div class="hl-kpi-top">
                        <div class="hl-kpi-top-left">
                            <span class="hl-kpi-icon hl-kpi-icon--@metric.ThemeColor" aria-hidden="true">
                                <svg viewBox="0 0 24 24">@Html.Raw(metric.IconSvg)</svg>
                            </span>
                            <span class="hl-kpi-title">@metric.Title</span>
                        </div>
                        <button type="button" class="hl-kpi-menu" aria-label="Opciones de @metric.Title">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                        </button>
                    </div>
                    <p class="hl-kpi-value">@metric.Value</p>
                    <div class="hl-kpi-footer">
                        <p class="hl-kpi-trend hl-kpi-trend--@metric.TrendType">
                            @if (metric.TrendType == "up")
                            {
                                <span class="hl-kpi-trend-icon" aria-hidden="true">▲</span>
                            }
                            else if (metric.TrendType == "warning")
                            {
                                <span class="hl-kpi-trend-icon" aria-hidden="true">!</span>
                            }
                            else
                            {
                                <span class="hl-kpi-trend-icon" aria-hidden="true">▼</span>
                            }
                            @metric.TrendText
                        </p>
                        <div class="hl-kpi-spark" role="img" aria-label="Tendencia de @metric.Title">
                            <canvas id="hl-metric-chart-@mi"></canvas>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>

    <!-- ═══════════ MÓDULOS DEL SISTEMA (catálogo modular) ═══════════ -->
    <div class="hl-modulos-section mb-5">
        <div class="mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
                <div>
                    <h2 class="h5 fw-bold m-0" style="color: var(--text-primary);">Módulos del Sistema</h2>
                    <p class="m-0 mt-1" style="color: var(--text-muted); font-size: 13.5px;">
                        Accede a cada área funcional del ERP · <span id="hl-modulos-count">@totalModulos</span> módulos
                    </p>
                </div>
                <label class="hl-modulos-search" for="hl-modulos-search-input">
                    <svg class="hl-modulos-search-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="search"
                           id="hl-modulos-search-input"
                           class="hl-modulos-search-input"
                           placeholder="Buscar módulos..."
                           autocomplete="off"
                           aria-label="Buscar módulos" />
                    <button type="button" id="hl-modulos-search-clear" class="hl-modulos-search-clear d-none" aria-label="Limpiar búsqueda">&times;</button>
                </label>
            </div>
            <div class="hl-modulos-filters d-flex flex-wrap gap-2" role="tablist" aria-label="Filtrar módulos por categoría">
                @foreach (var cat in categorias)
                {
                    <button type="button"
                            class="hl-modulo-filter@(cat.Id == ModuloCategoria.Todos ? " active" : "")"
                            data-category="@cat.Id"
                            role="tab"
                            aria-selected="@(cat.Id == ModuloCategoria.Todos ? "true" : "false")">
                        @cat.Label
                    </button>
                }
            </div>
        </div>

        <div class="row g-3" id="hl-modulos-grid">
            @foreach (var module in Model.QuickAccessModules)
            {
                var catLabel = categorias.FirstOrDefault(c => c.Id == module.Category).Label ?? module.Category;
                var searchText = $"{module.Name} {module.Description} {catLabel} {module.BadgeText} {module.Controller}".ToLowerInvariant();
                <div class="col-12 col-md-6 col-lg-4 col-xxl-3 hl-modulo-item"
                     data-category="@module.Category"
                     data-search="@searchText">
                    <a asp-controller="@module.Controller" asp-action="@module.Action"
                       class="text-decoration-none hl-module-card-link"
                       aria-label="Ir a @module.Name">
                        <div class="card border-0 shadow-sm rounded-3 h-100 hl-module-card"
                             style="background: var(--bg-topbar); border: 1px solid var(--border-color); transition: all 0.2s ease;">
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-start mb-3 gap-2">
                                        <div class="hl-card-icon-wrap rounded-3 d-flex align-items-center justify-content-center flex-shrink-0">
                                            <svg class="hl-icon" viewBox="0 0 24 24" style="width: 18px; height: 18px; stroke-width: 2;">
                                                @Html.Raw(module.IconSvg)
                                            </svg>
                                        </div>
                                        <div class="d-flex flex-column align-items-end gap-1">
                                            <span class="hl-modulo-tag">@catLabel</span>
                                            @if (!string.IsNullOrEmpty(module.BadgeText))
                                            {
                                                <span class="hl-status-badge hl-badge-@module.BadgeType px-2.5 py-1" style="font-size: 11px;">
                                                    @module.BadgeText
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <h4 class="h6 fw-bold mb-2" style="color: var(--text-primary); font-size: 15px;">@module.Name</h4>
                                    <p class="m-0" style="color: var(--text-secondary); font-size: 13px; line-height: 1.5; min-height: 52px;">
                                        @module.Description
                                    </p>
                                </div>
                                <div class="d-flex justify-content-end mt-3">
                                    <span class="hl-module-arrow" aria-hidden="true">
                                        <svg class="hl-icon" viewBox="0 0 24 24">
                                            <line x1="5" y1="12" x2="19" y2="12"/>
                                            <polyline points="12 5 19 12 12 19"/>
                                        </svg>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>

        <p id="hl-modulos-empty" class="text-center py-4 m-0 d-none" style="color: var(--text-muted); font-size: 14px;">
            No se encontraron módulos con ese criterio.
        </p>
    </div>

    <!-- ═══════════ DOUBLE-COLUMN DETAIL PANEL ═══════════ -->
    <div class="row g-4">
        <!-- Left: Recent Sales -->
        <div class="col-12 col-xl-7">
            <div class="card border-0 shadow-sm rounded-3" style="background: var(--bg-topbar); border: 1px solid var(--border-color) !important;">
                <div class="card-header bg-transparent border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                    <h2 class="h6 fw-bold m-0" style="color: var(--text-primary); font-size: 15px;">Últimas Transacciones</h2>
                    <a href="/Ventas" class="text-decoration-none fw-semibold text-primary" style="font-size: 12.5px; color: var(--sys-primary) !important;">Ver todas</a>
                </div>
                <div class="card-body p-4 pt-3">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle m-0" style="min-width: 500px;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--border-color); font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600;">
                                    <th scope="col" class="pb-3 ps-0">Comprobante</th>
                                    <th scope="col" class="pb-3">Cliente</th>
                                    <th scope="col" class="pb-3">Fecha</th>
                                    <th scope="col" class="pb-3 text-end">Monto</th>
                                    <th scope="col" class="pb-3 text-end pe-0">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sale in Model.RecentSales)
                                {
                                    <tr style="border-bottom: 1px solid var(--border-color); font-size: 13.5px; color: var(--text-primary);">
                                        <td class="py-3 ps-0 fw-semibold">@sale.InvoiceNumber</td>
                                        <td class="py-3" style="color: var(--text-primary);">@sale.Customer</td>
                                        <td class="py-3" style="color: var(--text-muted); font-size: 12.5px;">@sale.Date</td>
                                        <td class="py-3 text-end fw-semibold">@sale.Amount</td>
                                        <td class="py-3 text-end pe-0">
                                            <span class="hl-status-badge hl-badge-@sale.StatusType px-2.5 py-1" style="font-size: 11px;">@sale.Status</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Recent Activities -->
        <div class="col-12 col-xl-5">
            <div class="card border-0 shadow-sm rounded-3" style="background: var(--bg-topbar); border: 1px solid var(--border-color) !important; height: 100%;">
                <div class="card-header bg-transparent border-0 p-4 pb-0">
                    <h2 class="h6 fw-bold m-0" style="color: var(--text-primary); font-size: 15px;">Actividad Reciente del Sistema</h2>
                </div>
                <div class="card-body p-4 pt-4">
                    <div class="position-relative ps-3" style="border-left: 2px solid var(--border-color);">
                        @for (int i = 0; i < Model.RecentActivities.Count; i++)
                        {
                            var act = Model.RecentActivities[i];
                            var isLast = i == Model.RecentActivities.Count - 1;
                            <div class="position-relative mb-4 @(isLast ? "mb-0" : "")">
                                <!-- Point on line -->
                                <span class="hl-timeline-point hl-timeline-point-@act.Type"></span>
                                <div>
                                    <p class="m-0 fw-medium" style="color: var(--text-primary); font-size: 13.5px; line-height: 1.4;">
                                        @act.Description
                                    </p>
                                    <div class="d-flex align-items-center gap-2 mt-1.5" style="font-size: 11.5px; color: var(--text-muted);">
                                        <span>@act.TimeAgo</span>
                                        <span>•</span>
                                        <span>Por: @act.User</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Dashboard header */
    .hl-dash-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem 1.5rem;
    }
    .hl-dash-greeting {
        font-size: 1.65rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        color: var(--text-primary);
        margin: 0 0 0.35rem;
        line-height: 1.2;
    }
    .hl-dash-subtitle {
        margin: 0;
        font-size: 14px;
        color: var(--text-muted);
    }
    .hl-dash-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.45rem 0.9rem;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--text-secondary);
        background: var(--bg-topbar);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-full);
        white-space: nowrap;
    }
    .hl-dash-pill svg {
        width: 15px;
        height: 15px;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        flex-shrink: 0;
    }
    .hl-dash-pill--status {
        color: #15803d;
        border-color: color-mix(in srgb, #22c55e 35%, var(--border-color));
    }
    .hl-dash-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 0 2px color-mix(in srgb, #22c55e 30%, transparent);
    }

    /* KPI cards (mockup) */
    .hl-kpi-card {
        background: var(--bg-topbar);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 1.15rem 1.25rem 1rem;
        height: 100%;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hl-kpi-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.85rem;
    }
    .hl-kpi-top-left {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        min-width: 0;
    }
    .hl-kpi-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .hl-kpi-icon svg {
        width: 18px;
        height: 18px;
        stroke: #fff;
        fill: none;
        stroke-width: 2;
    }
    .hl-kpi-icon--primary { background: linear-gradient(135deg, #3b82f6, #2563eb); }
    .hl-kpi-icon--success { background: linear-gradient(135deg, #22c55e, #16a34a); }
    .hl-kpi-icon--warning { background: linear-gradient(135deg, #f59e0b, #d97706); }
    .hl-kpi-icon--purple { background: linear-gradient(135deg, #a78bfa, #7c3aed); }
    .hl-kpi-title {
        font-size: 13px;
        font-weight: 500;
        color: var(--text-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .hl-kpi-menu {
        border: none;
        background: transparent;
        color: var(--text-muted);
        padding: 0.2rem 0.35rem;
        border-radius: 6px;
        cursor: pointer;
        line-height: 1;
        opacity: 0.6;
        transition: opacity 0.15s, background 0.15s;
    }
    .hl-kpi-menu:hover {
        opacity: 1;
        background: var(--bg-app);
    }
    .hl-kpi-menu svg {
        width: 18px;
        height: 18px;
        fill: currentColor;
        stroke: none;
    }
    .hl-kpi-value {
        font-size: 1.65rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        color: var(--text-primary);
        margin: 0 0 0.75rem;
        line-height: 1.1;
    }
    .hl-kpi-footer {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 0.5rem;
    }
    .hl-kpi-trend {
        margin: 0;
        font-size: 11.5px;
        font-weight: 600;
        line-height: 1.35;
        display: flex;
        align-items: flex-start;
        gap: 0.25rem;
        flex: 1;
        min-width: 0;
    }
    .hl-kpi-trend-icon {
        font-size: 10px;
        line-height: 1.5;
        flex-shrink: 0;
    }
    .hl-kpi-trend--up { color: #16a34a; }
    .hl-kpi-trend--warning { color: #d97706; }
    .hl-kpi-trend--down { color: #dc2626; }
    .hl-kpi-spark {
        width: 108px;
        height: 44px;
        flex-shrink: 0;
    }
    .hl-kpi-spark canvas {
        display: block;
        width: 108px !important;
        height: 44px !important;
    }

    .hl-modulos-search {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
        max-width: 320px;
        padding: 0.5rem 0.85rem 0.5rem 0.75rem;
        background: var(--bg-topbar);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-full);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        margin: 0;
        cursor: text;
    }
    .hl-modulos-search:focus-within {
        border-color: var(--sys-ring);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--sys-primary) 15%, transparent);
    }
    .hl-modulos-search-icon {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        stroke: var(--text-muted);
        fill: none;
        stroke-width: 2;
    }
    .hl-modulos-search-input {
        flex: 1;
        min-width: 0;
        border: none;
        background: transparent;
        font-size: 14px;
        color: var(--text-primary);
        outline: none;
    }
    .hl-modulos-search-input::placeholder {
        color: var(--text-muted);
    }
    .hl-modulos-search-clear {
        border: none;
        background: var(--bg-app);
        color: var(--text-muted);
        width: 22px;
        height: 22px;
        border-radius: var(--radius-full);
        font-size: 16px;
        line-height: 1;
        padding: 0;
        cursor: pointer;
        flex-shrink: 0;
    }
    .hl-modulos-search-clear:hover {
        color: var(--text-primary);
        background: var(--border-color);
    }

    .hl-modulos-filters .hl-modulo-filter {
        border: 1px solid var(--border-color);
        background: var(--bg-topbar);
        color: var(--text-secondary);
        font-size: 12.5px;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: var(--radius-full);
        transition: background var(--transition), color var(--transition), border-color var(--transition);
    }
    .hl-modulos-filters .hl-modulo-filter:hover {
        border-color: var(--sys-border);
        color: var(--text-primary);
    }
    .hl-modulos-filters .hl-modulo-filter.active {
        background: #0d9488;
        border-color: #0d9488;
        color: #fff;
    }
    [data-theme="dark"] .hl-modulos-filters .hl-modulo-filter.active {
        background: #14b8a6;
        border-color: #14b8a6;
    }
    .hl-modulo-tag {
        font-size: 10.5px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-muted);
        background: var(--bg-app);
        border: 1px solid var(--border-color);
        padding: 2px 8px;
        border-radius: var(--radius-full);
    }
    .hl-modulo-item {
        transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .hl-modulo-item.is-hidden {
        display: none !important;
    }

    /* Premium micro-interactions & transitions */
    .hl-kpi-card.hl-metric-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
    }
    
    .hl-module-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg) !important;
        border-color: var(--sys-ring) !important;
    }
    
    .hl-module-arrow {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: var(--radius-full);
        background: var(--sys-soft-bg);
        border: 1px solid var(--sys-border);
        color: var(--sys-primary);
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                    background 0.2s ease,
                    border-color 0.2s ease,
                    color 0.2s ease,
                    box-shadow 0.2s ease;
    }
    .hl-module-arrow .hl-icon {
        width: 18px;
        height: 18px;
        stroke-width: 2.25;
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .hl-module-card-link:hover .hl-module-arrow,
    .hl-module-card:hover .hl-module-arrow {
        background: var(--sys-primary);
        border-color: var(--sys-primary);
        color: var(--sys-on-primary);
        box-shadow: 0 4px 12px color-mix(in srgb, var(--sys-primary) 35%, transparent);
        transform: translateX(4px);
    }
    .hl-module-card-link:hover .hl-module-arrow .hl-icon,
    .hl-module-card:hover .hl-module-arrow .hl-icon {
        transform: translateX(2px);
    }

    .hl-card-icon-wrap {
        width: 40px;
        height: 40px;
        background-color: var(--bg-app);
        border: 1px solid var(--border-color);
        color: var(--text-secondary);
        transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }
    
    .hl-metric-card:hover .hl-card-icon-wrap,
    .hl-module-card:hover .hl-card-icon-wrap {
        background-color: rgba(67, 56, 202, 0.08) !important;
        border-color: var(--sys-ring) !important;
        color: var(--sys-primary) !important;
    }
    
    [data-theme="dark"] .hl-metric-card:hover .hl-card-icon-wrap,
    [data-theme="dark"] .hl-module-card:hover .hl-card-icon-wrap,
    [data-bs-theme="dark"] .hl-metric-card:hover .hl-card-icon-wrap,
    [data-bs-theme="dark"] .hl-module-card:hover .hl-card-icon-wrap {
        background-color: rgba(129, 140, 248, 0.12) !important;
        border-color: var(--sys-ring) !important;
        color: var(--sys-ring) !important;
    }

    .animate-fade-in {
        animation: fadeIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(function () {
    var chartsPayload = @Html.Raw(metricsChartsJson);
    var palette = {
        primary: { main: '#3b82f6', soft: 'rgba(59, 130, 246, 0.14)' },
        success: { main: '#22c55e', soft: 'rgba(34, 197, 94, 0.14)' },
        warning: { main: '#f59e0b', soft: 'rgba(245, 158, 11, 0.14)' },
        purple: { main: '#8b5cf6', soft: 'rgba(139, 92, 246, 0.14)' }
    };

    function initMetricCharts() {
        if (typeof Chart === 'undefined' || !chartsPayload || !chartsPayload.length) return;

        chartsPayload.forEach(function (cfg, i) {
            var canvas = document.getElementById('hl-metric-chart-' + i);
            if (!canvas || !cfg.values || !cfg.values.length) return;

            var theme = palette[cfg.themeColor] || palette.primary;
            var labels = (cfg.labels && cfg.labels.length) ? cfg.labels : cfg.values.map(function (_, j) { return String(j + 1); });

            new Chart(canvas, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        data: cfg.values,
                        borderColor: theme.main,
                        backgroundColor: theme.soft,
                        borderWidth: 2,
                        fill: true,
                        tension: 0.42,
                        pointRadius: 0,
                        pointHoverRadius: 0
                    }]
                },
                options: {
                    responsive: false,
                    maintainAspectRatio: false,
                    animation: { duration: 600 },
                    plugins: {
                        legend: { display: false },
                        tooltip: { enabled: false }
                    },
                    scales: {
                        x: { display: false },
                        y: { display: false }
                    },
                    interaction: { mode: 'index', intersect: false }
                }
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMetricCharts);
    } else {
        initMetricCharts();
    }
})();

(function () {
    var filters = document.querySelectorAll('.hl-modulo-filter');
    var items = document.querySelectorAll('.hl-modulo-item');
    var countEl = document.getElementById('hl-modulos-count');
    var emptyEl = document.getElementById('hl-modulos-empty');
    var searchInput = document.getElementById('hl-modulos-search-input');
    var searchClear = document.getElementById('hl-modulos-search-clear');
    var activeCategory = 'todos';

    if (!items.length) return;

    function normalize(str) {
        return (str || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    function applyFilters() {
        var query = normalize(searchInput ? searchInput.value.trim() : '');
        var visible = 0;

        items.forEach(function (el) {
            var matchCategory = activeCategory === 'todos' || el.getAttribute('data-category') === activeCategory;
            var haystack = normalize(el.getAttribute('data-search') || '');
            var matchSearch = !query || haystack.indexOf(query) !== -1;
            var show = matchCategory && matchSearch;
            el.classList.toggle('is-hidden', !show);
            if (show) visible++;
        });

        if (countEl) countEl.textContent = String(visible);
        if (emptyEl) emptyEl.classList.toggle('d-none', visible > 0);
        if (searchClear) searchClear.classList.toggle('d-none', !query);
    }

    filters.forEach(function (btn) {
        btn.addEventListener('click', function () {
            activeCategory = btn.getAttribute('data-category') || 'todos';
            filters.forEach(function (b) {
                var active = b === btn;
                b.classList.toggle('active', active);
                b.setAttribute('aria-selected', active ? 'true' : 'false');
            });
            applyFilters();
        });
    });

    if (searchInput) {
        searchInput.addEventListener('input', applyFilters);
        searchInput.addEventListener('search', applyFilters);
    }

    if (searchClear && searchInput) {
        searchClear.addEventListener('click', function () {
            searchInput.value = '';
            searchInput.focus();
            applyFilters();
        });
    }

    applyFilters();
})();
</script>
}
