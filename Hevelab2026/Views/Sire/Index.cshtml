        function renderSunatProposal() {
            var activeTab = tabRV.classList.contains("active") ? "rv" : "rc";
            var periodValue = selectPeriodo.value;
            var cleanPeriod = periodValue.replace("-", "");

            var rawData = (activeTab === "rv") ? dbVentas : dbCompras;
            var periodData = rawData.filter(function(item) { return item.periodo === cleanPeriod; });
            
            var tbody = document.getElementById("drawer-comparison-body");
            tbody.innerHTML = "";

            if (periodData.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" style="text-align: center; padding: 20px; color: var(--cta-text-muted);">No hay comprobantes en este período para comparar.</td></tr>`;
                return;
            }

            periodData.forEach(function(item, index) {
                var compNumber = item.serie + "-" + item.correlativo;
                
                // Real comparison - first item gets simulated rounding discrepancy
                var sunatTotal = item.total;
                if (index === 0) {
                    sunatTotal = item.total + 0.02;
                }

                var tuTotal = item.total;
                var dif = sunatTotal - tuTotal;
                var hasDiff = Math.abs(dif) > 0.01;
                
                var trStyle = hasDiff ? 'background: #eef2ff; font-weight: 600;' : '';
                var tdClass = hasDiff ? 'style="padding: 10px 12px; border-bottom: 1px solid var(--cta-border); color: #1e3a8a;"' : 'style="padding: 10px 12px; border-bottom: 1px solid var(--cta-border); color: var(--cta-text-primary);"';
                var tdRightClass = hasDiff ? 'style="padding: 10px 12px; border-bottom: 1px solid var(--cta-border); text-align: right; color: #1e3a8a;"' : 'style="padding: 10px 12px; border-bottom: 1px solid var(--cta-border); text-align: right; color: var(--cta-text-primary);"';

                var rowHtml = `
                    <tr style="${trStyle}">
                        <td ${tdClass}>${compNumber}</td>
                        <td ${tdRightClass}>S/ ${formatNumberOnly(sunatTotal)}</td>
                        <td ${tdRightClass}>S/ ${formatNumberOnly(tuTotal)}</td>
                        <td ${tdRightClass} style="color: ${dif !== 0 ? '#ef4444' : '#10b981'}; font-weight: 700;">S/ ${formatNumberOnly(dif)}</td>
                    </tr>
                `;
                tbody.insertAdjacentHTML("beforeend", rowHtml);
            });
        }

