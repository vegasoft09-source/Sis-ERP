@using Hevelab2026.Models
@{
    ViewData["Title"] = "Clientes";
    var clientes = (List<Cliente>)(ViewBag.Clientes ?? new List<Cliente>());
    int totalActivos   = clientes.Count(c => c.Activo);
    int totalInactivos = clientes.Count(c => !c.Activo);
    decimal creditoTotal = clientes.Sum(c => c.LimiteCredito);
}

<!-- ===== KPI ROW ===== -->
<div class="row g-3 mb-4">

    <!-- Total Clientes -->
    <div class="col-6 col-lg-3">
        <div class="cl-kpi">
            <div class="cl-kpi__icon cl-kpi__icon--blue">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div>
                <div class="cl-kpi__label">Total Clientes</div>
                <div class="cl-kpi__value" id="kpiTotal">@clientes.Count</div>
            </div>
        </div>
    </div>

    <!-- Activos -->
    <div class="col-6 col-lg-3">
        <div class="cl-kpi">
            <div class="cl-kpi__icon cl-kpi__icon--green">
                <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div>
                <div class="cl-kpi__label">Activos</div>
                <div class="cl-kpi__value" style="color:#16a34a;" id="kpiActivos">@totalActivos</div>
            </div>
        </div>
    </div>

    <!-- Inactivos -->
    <div class="col-6 col-lg-3">
        <div class="cl-kpi">
            <div class="cl-kpi__icon cl-kpi__icon--gray">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
            </div>
            <div>
                <div class="cl-kpi__label">Inactivos</div>
                <div class="cl-kpi__value" id="kpiInactivos">@totalInactivos</div>
            </div>
        </div>
    </div>

    <!-- Crédito (dinámico según selección) -->
    <div class="col-6 col-lg-3">
        <div class="cl-kpi cl-kpi--dynamic" id="kpiCreditoCard">
            <div class="cl-kpi__icon cl-kpi__icon--primary">
                <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div>
                <div class="cl-kpi__label" id="kpiCreditoLabel">Crédito Total</div>
                <div class="cl-kpi__value" style="color:var(--sys-primary);font-size:1rem;" id="kpiCreditoValor">
                    S/ @creditoTotal.ToString("N0", new System.Globalization.CultureInfo("es-PE"))
                </div>
                <div class="cl-kpi__sub" id="kpiCreditoSub" style="display:none;"></div>
            </div>
        </div>
    </div>
</div>

<!-- ===== TOOLBAR ===== -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="cl-title">Clientes</h1>
        <p class="cl-subtitle">Gestión y catálogo del módulo de Ventas</p>
    </div>
    <a href="/Clientes/Formulario" class="cl-btn-primary" id="btn-nuevo-cliente">
        <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nuevo Cliente
    </a>
</div>

<!-- ===== FILTROS ===== -->
<div class="cl-filters mb-3">
    <form method="get" action="/Clientes" class="d-flex flex-wrap gap-2 align-items-center">
        <div class="cl-search">
            <svg class="cl-search__ico" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input id="busquedaInput" type="text" name="busqueda" class="cl-search__input"
                   placeholder="Razón social o N° documento…"
                   value="@ViewBag.Busqueda" autocomplete="off" />
        </div>

        <select name="estado" class="cl-select" onchange="this.form.submit()" id="estadoFilter">
            <option value="">Todos los estados</option>
            @if (ViewBag.Estado == "activo") {   <option value="activo" selected>Activo</option>   }
            else {                               <option value="activo">Activo</option>             }
            @if (ViewBag.Estado == "inactivo") { <option value="inactivo" selected>Inactivo</option> }
            else {                              <option value="inactivo">Inactivo</option>           }
        </select>

        <button type="submit" class="cl-btn-secondary">
            <svg viewBox="0 0 24 24"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            Filtrar
        </button>

        @if (!string.IsNullOrEmpty(ViewBag.Busqueda as string) || !string.IsNullOrEmpty(ViewBag.Estado as string))
        {
            <a href="/Clientes" class="cl-btn-ghost">
                <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Limpiar
            </a>
        }
    </form>
</div>

<!-- ===== TABLA ===== -->
<div class="cl-card">
    <div class="cl-table-wrap">
        <table class="cl-table" id="tablaClientes">
            <thead>
                <tr>
                    <th class="cl-th" style="width:32px;"></th>
                    <th class="cl-th" style="width:100px;">Código</th>
                    <th class="cl-th">Razón Social / Nombres</th>
                    <th class="cl-th cl-hide-sm">Tipo Doc.</th>
                    <th class="cl-th cl-hide-sm">N° Documento</th>
                    <th class="cl-th cl-hide-md">Ciudad</th>
                    <th class="cl-th">Estado</th>
                    <th class="cl-th" style="width:110px; text-align:center;">Acciones</th>
                </tr>
            </thead>
            <tbody id="cuerpoTabla">
            @if (clientes.Count > 0)
            {
                foreach (var c in clientes)
                {
                    <tr class="cl-tr cliente-row"
                        data-id="@c.Id"
                        data-razon="@c.RazonSocial"
                        data-documento="@c.NumeroDocumento"
                        data-credito="@c.LimiteCredito.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)"
                        data-activo="@c.Activo.ToString().ToLower()">
                        <!-- Radio de selección -->
                        <td class="cl-td">
                            <input type="radio" name="clienteSeleccionado"
                                   class="cl-radio" id="radio-@c.Id"
                                   value="@c.Id"
                                   data-nombre="@c.RazonSocial"
                                   data-credito="@c.LimiteCredito.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)" />
                        </td>
                        <td class="cl-td"><span class="cl-code">@c.Codigo</span></td>
                        <td class="cl-td">
                            <div class="cl-cell-name">@c.RazonSocial</div>
                            <div class="cl-cell-type">@c.TipoCliente</div>
                        </td>
                        <td class="cl-td cl-hide-sm">@c.TipoDocumento</td>
                        <td class="cl-td cl-hide-sm"><span class="cl-mono">@c.NumeroDocumento</span></td>
                        <td class="cl-td cl-hide-md">@c.Ciudad</td>
                        <td class="cl-td">
                            @if (c.Activo)
                            { <span class="cl-badge cl-badge--on">Activo</span> }
                            else
                            { <span class="cl-badge cl-badge--off">Inactivo</span> }
                        </td>
                        <td class="cl-td" style="text-align:center;">
                            <div class="cl-actions">
                                <a href="/Clientes/Detalle/@c.Id" class="cl-act" title="Ver detalle">
                                    <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                </a>
                                <a href="/Clientes/Formulario/@c.Id" class="cl-act" title="Editar">
                                    <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
                                </a>
                                <form method="post" action="/Clientes/ToggleEstado" class="form-toggle-estado" style="display:inline;margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="cl-act @(c.Activo ? "cl-act--off" : "cl-act--on")"
                                            title="@(c.Activo ? "Desactivar" : "Activar")">
                                        @if (c.Activo) {
                                            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                        } else {
                                            <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                        }
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="cl-empty">
                        <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                        <p>No se encontraron clientes con los filtros seleccionados.</p>
                        <a href="/Clientes" class="cl-btn-ghost">Ver todos</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="cl-foot">
        <span id="contadorClientes">
            Mostrando <strong>@clientes.Count</strong> cliente@(clientes.Count != 1 ? "s" : "")
            @if (!string.IsNullOrEmpty(ViewBag.Busqueda as string) || !string.IsNullOrEmpty(ViewBag.Estado as string))
            { <span class="cl-filtered">(filtrado)</span> }
        </span>
        <span id="seleccionInfo" class="cl-sel-info" style="display:none;">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Cliente seleccionado: <strong id="seleccionNombre"></strong>
        </span>
    </div>
</div>

@section Scripts {
<script src="~/js/clientes.js" asp-append-version="true"></script>
<script>
(function () {
    'use strict';

    /* ---- Búsqueda en tiempo real ---- */
    var busquedaInput = document.getElementById('busquedaInput');
    if (busquedaInput) {
        busquedaInput.addEventListener('input', function () {
            var term = this.value.toLowerCase().trim();
            var rows  = document.querySelectorAll('.cliente-row');
            var vis   = 0;
            rows.forEach(function (row) {
                var razon = (row.dataset.razon || '').toLowerCase();
                var doc   = (row.dataset.documento || '').toLowerCase();
                var show  = razon.includes(term) || doc.includes(term);
                row.style.display = show ? '' : 'none';
                if (show) vis++;
            });
            var cnt = document.getElementById('contadorClientes');
            if (cnt) cnt.querySelector('strong').textContent = vis;
        });
    }

    /* ---- KPI Crédito: valores originales para poder resetear ---- */
    var kpiCreditoLabel = document.getElementById('kpiCreditoLabel');
    var kpiCreditoValor = document.getElementById('kpiCreditoValor');
    var kpiCreditoSub   = document.getElementById('kpiCreditoSub');
    var kpiCreditoCard  = document.getElementById('kpiCreditoCard');
    var seleccionInfo   = document.getElementById('seleccionInfo');
    var seleccionNombre = document.getElementById('seleccionNombre');

    var LABEL_ORIGINAL = 'Crédito Total';
    var VALOR_ORIGINAL = kpiCreditoValor ? kpiCreditoValor.textContent.trim() : '';

    /* Función: seleccionar un cliente */
    function seleccionarCliente(radio) {
        var nombre  = radio.dataset.nombre;
        var credito = parseFloat(radio.dataset.credito) || 0;
        var fmt     = 'S/ ' + credito.toLocaleString('es-PE', { minimumFractionDigits: 0, maximumFractionDigits: 0 });

        if (kpiCreditoLabel) kpiCreditoLabel.textContent = 'Límite Crédito';
        if (kpiCreditoValor) kpiCreditoValor.textContent  = fmt;
        if (kpiCreditoSub)   { kpiCreditoSub.textContent = nombre; kpiCreditoSub.style.display = 'block'; }
        if (kpiCreditoCard)  kpiCreditoCard.classList.add('has-selection');
        if (seleccionNombre) seleccionNombre.textContent = nombre;
        if (seleccionInfo)   seleccionInfo.style.display = 'inline-flex';

        document.querySelectorAll('.cl-tr').forEach(function (r) { r.classList.remove('is-selected'); });
        var fila = radio.closest('.cl-tr');
        if (fila) fila.classList.add('is-selected');
    }

    /* Función: deseleccionar (resetear a totales) */
    function deseleccionarCliente(radio) {
        radio.checked = false;

        if (kpiCreditoLabel) kpiCreditoLabel.textContent = LABEL_ORIGINAL;
        if (kpiCreditoValor) kpiCreditoValor.textContent  = VALOR_ORIGINAL;
        if (kpiCreditoSub)   { kpiCreditoSub.textContent = ''; kpiCreditoSub.style.display = 'none'; }
        if (kpiCreditoCard)  kpiCreditoCard.classList.remove('has-selection');
        if (seleccionNombre) seleccionNombre.textContent = '';
        if (seleccionInfo)   seleccionInfo.style.display = 'none';

        document.querySelectorAll('.cl-tr').forEach(function (r) { r.classList.remove('is-selected'); });
    }

    /* ---- Radio buttons: selección y deselección ---- */
    document.querySelectorAll('.cl-radio').forEach(function (radio) {
        /* Guardamos si estaba checked ANTES del click (mousedown) */
        radio.addEventListener('mousedown', function () {
            this._wasChecked = this.checked;
        });

        radio.addEventListener('click', function () {
            if (this._wasChecked) {
                /* Ya estaba seleccionado → deseleccionar */
                deseleccionarCliente(this);
            } else {
                /* Era nuevo → seleccionar */
                seleccionarCliente(this);
            }
        });
    });

    /* ---- Clic en fila → seleccionar / deseleccionar ---- */
    document.querySelectorAll('.cl-tr').forEach(function (row) {
        row.style.cursor = 'pointer';

        /* mousedown en fila: capturamos estado ANTES del click del radio */
        row.addEventListener('mousedown', function (e) {
            if (e.target.closest('.cl-actions') || e.target.closest('.form-toggle-estado')) return;
            var radio = row.querySelector('.cl-radio');
            if (radio) radio._wasChecked = radio.checked;
        });

        row.addEventListener('click', function (e) {
            if (e.target.closest('.cl-actions') || e.target.closest('.form-toggle-estado')) return;
            /* Si el click fue directo al radio, ya lo manejó el listener del radio */
            if (e.target.classList.contains('cl-radio')) return;

            var radio = row.querySelector('.cl-radio');
            if (!radio) return;

            if (radio._wasChecked) {
                deseleccionarCliente(radio);
            } else {
                radio.checked = true;
                seleccionarCliente(radio);
            }
        });

        /* Doble clic → ir al detalle */
        row.addEventListener('dblclick', function (e) {
            if (e.target.closest('.cl-actions') || e.target.closest('.form-toggle-estado')) return;
            var id = row.dataset.id;
            if (id) window.location.href = '/Clientes/Detalle/' + id;
        });
    });

    /* ---- Confirmación ToggleEstado ---- */
    document.querySelectorAll('.form-toggle-estado').forEach(function (form) {
        form.addEventListener('submit', function (e) {
            if (!confirm('¿Confirmas cambiar el estado de este cliente?')) e.preventDefault();
        });
    });

})();
</script>
}
