@model Hevelab2026.Models.Cliente

@{
    ViewData["Title"] = ViewBag.Cliente.RazonSocial;
    var cliente = ViewBag.Cliente as Hevelab2026.Models.Cliente;
}

<div class="frm-wrap" style="max-width: 1000px;">
    
    <!-- Topbar: Back & Analytics -->
    <div style="display:flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <a href="/Clientes" class="frm-back" style="background: transparent; border: none; font-weight: 700; color: var(--sys-primary);">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            REGRESAR
        </a>
        
        <style>
            .kpi-ribbon {
                display: flex;
                background: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 8px;
                padding: 12px 20px;
                justify-content: space-between;
                align-items: center;
                box-shadow: 0 1px 2px rgba(0,0,0,0.02);
            }
            .kpi-item {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 0 15px;
                position: relative;
            }
            .kpi-item:not(:last-child)::after {
                content: "";
                position: absolute;
                right: 0;
                top: 50%;
                transform: translateY(-50%);
                height: 30px;
                width: 1px;
                background-color: #f1f5f9;
            }
            .kpi-top {
                display: flex;
                align-items: center;
                gap: 6px;
                margin-bottom: 4px;
            }
            .kpi-icon {
                width: 16px;
                height: 16px;
                stroke-width: 2px;
            }
            .kpi-label {
                font-size: 10px;
                font-weight: 800;
                color: #8ba3c7;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }
            .kpi-value {
                font-size: 13px;
                font-weight: 800;
                color: #1e293b;
            }
        </style>
        <div class="kpi-ribbon">
            <div class="kpi-item">
                <div class="kpi-top">
                    <svg class="kpi-icon" style="color:#eab308; fill:none;" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    <span class="kpi-label">OPORTUNIDADES</span>
                </div>
                <span class="kpi-value">0</span>
            </div>
            <div class="kpi-item">
                <div class="kpi-top">
                    <svg class="kpi-icon" style="color:#8b5cf6;" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    <span class="kpi-label">VENTAS</span>
                </div>
                <span class="kpi-value">42</span>
            </div>
            <div class="kpi-item">
                <div class="kpi-top">
                    <svg class="kpi-icon" style="color:#3b82f6;" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                    <span class="kpi-label">FACTURADO</span>
                </div>
                <span class="kpi-value">S/ 1,934.91</span>
            </div>
            <div class="kpi-item">
                <div class="kpi-top">
                    <svg class="kpi-icon" style="color:#ef4444;" viewBox="0 0 24 24"><path d="M3 3v18h18"/><line x1="18" y1="9" x2="13" y2="14"/><line x1="13" y1="14" x2="8" y2="9"/><line x1="8" y1="9" x2="3" y2="14"/></svg>
                    <span class="kpi-label">ADEUDADO</span>
                </div>
                <span class="kpi-value">S/ 2,283.20</span>
            </div>
            <div class="kpi-item">
                <div class="kpi-top">
                    <svg class="kpi-icon" style="color:#6366f1;" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    <span class="kpi-label">REUNIONES</span>
                </div>
                <span class="kpi-value">0</span>
            </div>
            <div class="kpi-item">
                <div class="kpi-top">
                    <svg class="kpi-icon" style="color:#f97316;" viewBox="0 0 24 24"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
                    <span class="kpi-label">TAREAS</span>
                </div>
                <span class="kpi-value">0</span>
            </div>
            <div class="kpi-item">
                <div class="kpi-top">
                    <svg class="kpi-icon" style="color:#4f46e5;" viewBox="0 0 24 24"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/></svg>
                    <span class="kpi-label">TICKETS</span>
                </div>
                <span class="kpi-value">0</span>
            </div>
        </div>
    </div>

    <div class="frm-panel-clean">
        
        <div style="display: flex; gap: 40px;">
            <!-- Avatar area -->
            <div style="width: 150px; display: flex; flex-direction: column; align-items: center; gap: 15px; padding-top: 20px;">
                <label style="cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 15px;">
                    <input type="file" accept="image/*" style="display:none;" onchange="previewProfilePhoto(event)" />
                    <div id="avatar-preview" style="width: 120px; height: 120px; border-radius: 50%; border: 2px dashed var(--border-color); display: flex; align-items: center; justify-content: center; color: var(--text-muted); background: #f8fafc; overflow: hidden; position: relative;">
                        <svg id="avatar-icon" viewBox="0 0 24 24" style="width: 40px; height: 40px; stroke: currentColor; fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <span style="font-size: 10px; font-weight: 800; color: var(--sys-primary); text-transform: uppercase;">Cambiar fotografía</span>
                </label>
            </div>

            <!-- Form fields -->
            <div style="flex: 1;">
                <div class="frm-radio-group">
                    <label class="frm-radio" style="pointer-events: none;">
                        <input type="radio" value="Persona Natural" @(cliente.TipoCliente == "Persona Natural" ? "checked" : "")>
                        <div class="frm-radio-circle"></div>
                        <span>Persona</span>
                    </label>
                    <label class="frm-radio" style="pointer-events: none;">
                        <input type="radio" value="Persona Jurídica" @(cliente.TipoCliente == "Persona Jurídica" ? "checked" : "")>
                        <div class="frm-radio-circle"></div>
                        <span>Empresa</span>
                    </label>
                </div>

                <div class="frm-grid">
                    <div class="frm-field frm-field--full">
                        <label class="frm-label">Nombre Completo / Razón Social</label>
                        <input type="text" class="frm-input frm-input--readonly" value="@cliente.RazonSocial" readonly />
                    </div>

                    <div class="frm-field frm-field--half">
                        <label class="frm-label">Correo Electrónico</label>
                        <input type="email" class="frm-input frm-input--readonly" value="@cliente.Email" readonly />
                    </div>
                    <div class="frm-field frm-field--half">
                        <label class="frm-label">Puesto de trabajo</label>
                        <input type="text" class="frm-input frm-input--readonly" value="@cliente.PuestoTrabajo" readonly />
                    </div>

                    <div class="frm-field frm-field--half">
                        <label class="frm-label">Número de Identificación</label>
                        <input type="text" class="frm-input frm-input--readonly" value="@cliente.NumeroDocumento" readonly />
                    </div>
                    <div class="frm-field frm-field--half">
                        <label class="frm-label">Grupo Proveedor</label>
                        <input type="text" class="frm-input frm-input--readonly" value="@cliente.GrupoProveedor" readonly />
                    </div>

                    <div class="frm-field frm-field--half">
                        <label class="frm-label">Grupo Clientes</label>
                        <input type="text" class="frm-input frm-input--readonly" value="@cliente.GrupoClientes" readonly />
                    </div>
                    <div class="frm-field frm-field--half">
                        <label class="frm-label">Código</label>
                        <input type="text" class="frm-input frm-input--readonly" value="@cliente.Codigo" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- Dirección de entrega -->
        <div style="margin-top: 40px;">
            <h3 style="font-size: 16px; font-weight: 800; color: var(--sys-primary); margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                <svg viewBox="0 0 24 24" style="width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2.5;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                Dirección de entrega
            </h3>
            
            <div class="frm-grid">
                <div class="frm-field frm-field--full">
                    <label class="frm-label">Dirección</label>
                    <input type="text" class="frm-input frm-input--readonly" value="@cliente.Direccion" readonly />
                </div>
                
                <div class="frm-field" style="grid-column: span 1;">
                    <label class="frm-label">Distrito</label>
                    <input type="text" class="frm-input frm-input--readonly" readonly />
                </div>
                <div class="frm-field" style="grid-column: span 1;">
                    <label class="frm-label">Provincia</label>
                    <input type="text" class="frm-input frm-input--readonly" value="@cliente.Ciudad" readonly />
                </div>
                <div class="frm-field" style="grid-column: span 1;">
                    <label class="frm-label">ZIP</label>
                    <input type="text" class="frm-input frm-input--readonly" readonly />
                </div>
                <div class="frm-field" style="grid-column: span 1;">
                    <label class="frm-label">País</label>
                    <input type="text" class="frm-input frm-input--readonly" value="Perú" readonly />
                </div>
            </div>
        </div>

        <!-- Tabs -->
        <div style="margin-top: 40px;">
            <div class="frm-tabs" id="cliente-tabs">
                <button type="button" class="frm-tab active" data-target="tab-contacts">Contacts</button>
                <button type="button" class="frm-tab" data-target="tab-sales">Sales</button>
                <button type="button" class="frm-tab" data-target="tab-accounting">Contabilidad</button>
                <button type="button" class="frm-tab" data-target="tab-assign">Asignación de socio</button>
                <button type="button" class="frm-tab" data-target="tab-notes">Notes</button>
            </div>
            
            <div id="tab-contacts" class="frm-tab-content" style="display: block;">
                <table class="frm-table-clean" id="tbl-contacts">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>NOMBRE</th>
                            <th>RAZÓN SOCIAL</th>
                            <th>DISTRITO</th>
                            <th>CORREO ELECTRÓNICO</th>
                            <th>TELÉFONO</th>
                            <th>ACTIVIDADES</th>
                            <th>PAÍS</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-contacts">
                        <tr id="row-empty">
                            <td colspan="8" style="text-align:center; color:var(--text-muted); font-style:italic;">No hay contactos registrados</td>
                        </tr>
                        <tr id="row-add-contact">
                            <td colspan="8">
                                <button type="button" onclick="addContactMock()" style="background:none; border:none; color:var(--sys-primary); font-size:11px; font-weight:800; display:flex; align-items:center; gap:5px; cursor:pointer;">
                                    <svg viewBox="0 0 24 24" style="width:14px; height:14px; stroke:currentColor; fill:none; stroke-width:2;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                                    AGREGAR CONTACTO
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div id="tab-sales" class="frm-tab-content" style="display: none; padding: 40px 20px; text-align: center; color: var(--text-muted); background: #f8fafc; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                <svg viewBox="0 0 24 24" style="width: 32px; height: 32px; stroke: currentColor; fill: none; stroke-width: 1.5; margin-bottom: 10px;"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                <div>No hay ventas registradas para este cliente.</div>
            </div>
            <div id="tab-accounting" class="frm-tab-content" style="display: none; padding: 40px 20px; text-align: center; color: var(--text-muted); background: #f8fafc; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                <svg viewBox="0 0 24 24" style="width: 32px; height: 32px; stroke: currentColor; fill: none; stroke-width: 1.5; margin-bottom: 10px;"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="12" y1="4" x2="12" y2="20"/><line x1="2" y1="12" x2="22" y2="12"/></svg>
                <div>Sin información contable.</div>
            </div>
            <div id="tab-assign" class="frm-tab-content" style="display: none; padding: 40px 20px; text-align: center; color: var(--text-muted); background: #f8fafc; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                <svg viewBox="0 0 24 24" style="width: 32px; height: 32px; stroke: currentColor; fill: none; stroke-width: 1.5; margin-bottom: 10px;"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <div>No hay socios asignados.</div>
            </div>
            <div id="tab-notes" class="frm-tab-content" style="display: none; padding: 40px 20px; text-align: center; color: var(--text-muted); background: #f8fafc; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                <svg viewBox="0 0 24 24" style="width: 32px; height: 32px; stroke: currentColor; fill: none; stroke-width: 1.5; margin-bottom: 10px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                <div>Sin notas adicionales.</div>
            </div>
        </div>

    </div>

    <div class="frm-actions mb-5" style="justify-content: flex-start; padding-left: 20px;">
        <a href="/Clientes/Formulario/@cliente.Id" class="frm-btn-save" style="background: #3730a3; border-radius: 8px;">
            <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            Editar Cliente
        </a>
    </div>
</div>

@section Scripts {
<script>
    // Profile photo preview
    function previewProfilePhoto(event) {
        const file = event.target.files[0];
        if (file) {
            const url = URL.createObjectURL(file);
            const container = document.getElementById('avatar-preview');
            container.innerHTML = `<img src="${url}" style="width:100%; height:100%; object-fit:cover;" />`;
        }
    }

    // Tabs functionality
    document.querySelectorAll('#cliente-tabs .frm-tab').forEach(tab => {
        tab.addEventListener('click', function() {
            document.querySelectorAll('#cliente-tabs .frm-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.frm-tab-content').forEach(c => c.style.display = 'none');
            this.classList.add('active');
            document.getElementById(this.getAttribute('data-target')).style.display = 'block';
        });
    });

    // Mock in-memory data for contacts
    let mockContacts = [];
    let contactIdCounter = 1;

    function renderContacts() {
        const tbody = document.getElementById('tbody-contacts');
        // Clear all except the add button
        Array.from(tbody.children).forEach(child => {
            if (child.id !== 'row-add-contact' && child.id !== 'row-inline-form') {
                child.remove();
            }
        });

        if (mockContacts.length === 0) {
            const emptyRow = document.createElement('tr');
            emptyRow.innerHTML = `<td colspan="8" style="text-align:center; color:var(--text-muted); font-style:italic;">No hay contactos registrados</td>`;
            tbody.insertBefore(emptyRow, document.getElementById('row-add-contact'));
            return;
        }

        mockContacts.forEach(contact => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${contact.id}</td>
                <td>${contact.nombre}</td>
                <td>${contact.razon}</td>
                <td>${contact.distrito}</td>
                <td>${contact.email}</td>
                <td>${contact.telefono}</td>
                <td>${contact.actividad}</td>
                <td>${contact.pais}</td>
            `;
            tbody.insertBefore(tr, document.getElementById('row-add-contact'));
        });
    }

    function addContactMock() {
        const tbody = document.getElementById('tbody-contacts');
        
        // Prevent double open
        if (document.getElementById('row-inline-form')) return;

        const inlineForm = document.createElement('tr');
        inlineForm.id = 'row-inline-form';
        inlineForm.style.background = '#f8fafc';
        inlineForm.innerHTML = `
            <td>#</td>
            <td><input type="text" id="m_nombre" class="frm-input" placeholder="Nombre" style="height:28px; font-size:12px;"></td>
            <td><input type="text" id="m_razon" class="frm-input" placeholder="Razón Social" style="height:28px; font-size:12px;"></td>
            <td><input type="text" id="m_distrito" class="frm-input" placeholder="Distrito" style="height:28px; font-size:12px;"></td>
            <td><input type="email" id="m_email" class="frm-input" placeholder="Correo" style="height:28px; font-size:12px;"></td>
            <td><input type="text" id="m_telefono" class="frm-input" placeholder="Teléfono" style="height:28px; font-size:12px;"></td>
            <td><input type="text" id="m_actividad" class="frm-input" placeholder="Actividad" style="height:28px; font-size:12px;"></td>
            <td style="display:flex; gap:10px;">
                <button type="button" onclick="saveContactMock()" style="background:#16a34a; color:#fff; border:none; padding:4px 8px; border-radius:4px; font-size:11px; cursor:pointer;">Guardar</button>
                <button type="button" onclick="cancelContactMock()" style="background:#e2e8f0; color:#333; border:none; padding:4px 8px; border-radius:4px; font-size:11px; cursor:pointer;">X</button>
            </td>
        `;
        tbody.insertBefore(inlineForm, document.getElementById('row-add-contact'));
        
        // Remove empty row if exists
        const emptyRow = tbody.querySelector('tr td[colspan="8"]');
        if (emptyRow && emptyRow.parentElement.id !== 'row-add-contact') emptyRow.parentElement.remove();
    }

    function saveContactMock() {
        const contact = {
            id: contactIdCounter++,
            nombre: document.getElementById('m_nombre').value || '-',
            razon: document.getElementById('m_razon').value || '-',
            distrito: document.getElementById('m_distrito').value || '-',
            email: document.getElementById('m_email').value || '-',
            telefono: document.getElementById('m_telefono').value || '-',
            actividad: document.getElementById('m_actividad').value || '-',
            pais: 'Perú'
        };
        mockContacts.push(contact);
        document.getElementById('row-inline-form').remove();
        renderContacts();
    }

    function cancelContactMock() {
        document.getElementById('row-inline-form').remove();
        renderContacts();
    }

    // Initial render
    renderContacts();
</script>
}
