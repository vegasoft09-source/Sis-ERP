@model string

@using Hevelab2026.Models.Configuracion

@{

    var tab = Model;

}

<nav class="cfg-tabs" role="tablist" aria-label="Secciones de configuración">

    @foreach (var t in ConfiguracionTabs.All)

    {

        <a asp-controller="Configuracion" asp-action="Index" asp-route-tab="@t.Id"

           class="cfg-tab@(tab == t.Id ? " is-active" : "")"

           role="tab"

           aria-selected="@(tab == t.Id ? "true" : "false")">

            <span class="cfg-tab-icon" aria-hidden="true">

                @if (t.Icon == "building")

                {

                    <svg viewBox="0 0 24 24"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2"/><path d="M18 9h2a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/></svg>

                }

                else if (t.Icon == "globe")

                {

                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>

                }

                else if (t.Icon == "mail")

                {

                    <svg viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>

                }

                else

                {

                    <svg viewBox="0 0 24 24"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>

                }

            </span>

            <span>@t.Label</span>

        </a>

    }

</nav>

