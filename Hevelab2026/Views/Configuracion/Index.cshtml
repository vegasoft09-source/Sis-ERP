@model Hevelab2026.Models.Config.ConfiguracionPageViewModel
@{
    ViewData["Title"] = "Configuración";
    var tab = Model.Tab;
    var fotoUrl = Model.Perfil.FotoActual;
    if (string.IsNullOrEmpty(fotoUrl))
        fotoUrl = User.FindFirst("Foto")?.Value;
    if (string.IsNullOrEmpty(fotoUrl))
        fotoUrl = "/favicon.png";
}

<div class="w-full max-w-5xl mx-auto space-y-6 text-slate-800">
    @if (TempData["Success"] != null)
    {
        <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="p-3 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm">@TempData["Error"]</div>
    }

    <div>
        <h2 class="text-2xl font-bold text-slate-900">Configuración</h2>
        <p class="text-sm text-slate-500 mt-1">Perfil, empresa y usuarios del sistema</p>
    </div>

    <div class="flex flex-wrap gap-2 border-b border-slate-200 pb-1">
        <a href="/settings?tab=profile" class="px-4 py-2 text-sm font-semibold rounded-t-lg @(tab == "profile" ? "bg-white border border-b-0 border-slate-200 text-indigo-600" : "text-slate-500 hover:text-slate-700")">Mi perfil</a>
        <a href="/settings?tab=empresa" class="px-4 py-2 text-sm font-semibold rounded-t-lg @(tab == "empresa" ? "bg-white border border-b-0 border-slate-200 text-indigo-600" : "text-slate-500 hover:text-slate-700")">Empresa</a>
        <a href="/settings?tab=usuarios" class="px-4 py-2 text-sm font-semibold rounded-t-lg @(tab == "usuarios" ? "bg-white border border-b-0 border-slate-200 text-indigo-600" : "text-slate-500 hover:text-slate-700")">Usuarios</a>
    </div>

    @if (tab == "profile")
    {
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6">
            <form method="post" action="/settings/perfil" enctype="multipart/form-data" class="space-y-6">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Perfil.Id" />

                <div class="flex flex-col sm:flex-row gap-6 items-start">
                    <div class="text-center">
                        <img src="@fotoUrl" alt="Foto de perfil" class="w-24 h-24 rounded-full object-cover border-4 border-slate-100 mx-auto" id="previewFoto" />
                        <label class="mt-3 inline-block text-xs font-semibold text-indigo-600 cursor-pointer">
                            Cambiar foto
                            <input type="file" name="foto" accept="image/*" class="hidden" onchange="previewImage(this)" />
                        </label>
                    </div>
                    <div class="flex-1 grid grid-cols-1 md:grid-cols-2 gap-4 w-full">
                        <div>
                            <label asp-for="Perfil.Nombre" class="block text-xs font-bold text-slate-500 uppercase mb-1"></label>
                            <input asp-for="Perfil.Nombre" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm" />
                            <span asp-validation-for="Perfil.Nombre" class="text-red-500 text-xs"></span>
                        </div>
                        <div>
                            <label asp-for="Perfil.Apellido" class="block text-xs font-bold text-slate-500 uppercase mb-1"></label>
                            <input asp-for="Perfil.Apellido" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm" />
                            <span asp-validation-for="Perfil.Apellido" class="text-red-500 text-xs"></span>
                        </div>
                        <div>
                            <label asp-for="Perfil.NombreUsuario" class="block text-xs font-bold text-slate-500 uppercase mb-1"></label>
                            <input asp-for="Perfil.NombreUsuario" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm" />
                            <span asp-validation-for="Perfil.NombreUsuario" class="text-red-500 text-xs"></span>
                        </div>
                        <div>
                            <label asp-for="Perfil.Correo" class="block text-xs font-bold text-slate-500 uppercase mb-1"></label>
                            <input asp-for="Perfil.Correo" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm" />
                            <span asp-validation-for="Perfil.Correo" class="text-red-500 text-xs"></span>
                        </div>
                        <div>
                            <label asp-for="Perfil.Telefono" class="block text-xs font-bold text-slate-500 uppercase mb-1"></label>
                            <input asp-for="Perfil.Telefono" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Rol</label>
                            <input value="@Model.Perfil.RolNombre" class="w-full px-3 py-2 border border-slate-100 rounded-xl text-sm bg-slate-50" readonly />
                        </div>
                        <div>
                            <label asp-for="Perfil.Idioma" class="block text-xs font-bold text-slate-500 uppercase mb-1"></label>
                            <select asp-for="Perfil.Idioma" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm">
                                <option value="es-PE">Español (Perú)</option>
                                <option value="es">Español</option>
                                <option value="en">English</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="Perfil.ZonaHoraria" class="block text-xs font-bold text-slate-500 uppercase mb-1"></label>
                            <select asp-for="Perfil.ZonaHoraria" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm">
                                <option value="America/Lima">Lima (PET)</option>
                                <option value="America/Bogota">Bogotá</option>
                                <option value="America/Mexico_City">Ciudad de México</option>
                            </select>
                        </div>
                    </div>
                </div>

                <hr class="border-slate-100" />
                <h3 class="text-sm font-bold text-slate-700">Cambiar contraseña</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Perfil.NuevaContrasena" class="block text-xs font-bold text-slate-500 uppercase mb-1"></label>
                        <input asp-for="Perfil.NuevaContrasena" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm" />
                    </div>
                    <div>
                        <label asp-for="Perfil.ConfirmarContrasena" class="block text-xs font-bold text-slate-500 uppercase mb-1"></label>
                        <input asp-for="Perfil.ConfirmarContrasena" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm" />
                        <span asp-validation-for="Perfil.ConfirmarContrasena" class="text-red-500 text-xs"></span>
                    </div>
                </div>

                <div class="flex justify-end">
                    <button type="submit" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl">Guardar perfil</button>
                </div>
            </form>
        </div>
    }
    else if (tab == "empresa")
    {
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6">
            <form method="post" action="/settings/empresa" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Empresa.Id" />
                <div class="md:col-span-2">
                    <label asp-for="Empresa.RazonSocial" class="block text-xs font-bold text-slate-500 uppercase mb-1">Razón social</label>
                    <input asp-for="Empresa.RazonSocial" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm" required />
                </div>
                <div>
                    <label asp-for="Empresa.NombreComercial" class="block text-xs font-bold text-slate-500 uppercase mb-1">Nombre comercial</label>
                    <input asp-for="Empresa.NombreComercial" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm" />
                </div>
                <div>
                    <label asp-for="Empresa.Ruc" class="block text-xs font-bold text-slate-500 uppercase mb-1">RUC</label>
                    <input asp-for="Empresa.Ruc" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm" required />
                </div>
                <div>
                    <label asp-for="Empresa.Telefono" class="block text-xs font-bold text-slate-500 uppercase mb-1">Teléfono</label>
                    <input asp-for="Empresa.Telefono" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm" />
                </div>
                <div>
                    <label asp-for="Empresa.Correo" class="block text-xs font-bold text-slate-500 uppercase mb-1">Correo</label>
                    <input asp-for="Empresa.Correo" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm" />
                </div>
                <div class="md:col-span-2">
                    <label asp-for="Empresa.Direccion" class="block text-xs font-bold text-slate-500 uppercase mb-1">Dirección</label>
                    <input asp-for="Empresa.Direccion" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm" />
                </div>
                <div class="md:col-span-2 flex justify-end">
                    <button type="submit" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl">Guardar empresa</button>
                </div>
            </form>
        </div>
    }
    else
    {
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                    <tr>
                        <th class="px-4 py-3 text-left">Usuario</th>
                        <th class="px-4 py-3 text-left">Correo</th>
                        <th class="px-4 py-3 text-left">Rol</th>
                        <th class="px-4 py-3 text-left">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Usuarios)
                    {
                        <tr class="border-t border-slate-100">
                            <td class="px-4 py-3 flex items-center gap-3">
                                <img src="@(string.IsNullOrEmpty(u.Foto) ? "/favicon.png" : u.Foto)" class="w-8 h-8 rounded-full object-cover" alt="" />
                                <div>
                                    <div class="font-semibold">@u.NombreCompleto</div>
                                    <div class="text-xs text-slate-400">@@u.NombreUsuario</div>
                                </div>
                            </td>
                            <td class="px-4 py-3">@u.Correo</td>
                            <td class="px-4 py-3">@u.Rol</td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-0.5 rounded-full text-xs font-semibold @(u.Activo ? "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-500")">
                                    @(u.Activo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const r = new FileReader();
                r.onload = e => document.getElementById('previewFoto').src = e.target.result;
                r.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
