                    </div>
                    <div class="col-md-3">
                        <span class="frm-label">Fecha de Nacimiento</span>
                        <div class="det-val" id="detFechaNacimiento">-</div>
                    </div>
                    <div class="col-md-3">
                        <span class="frm-label">Género</span>
                        <div class="det-val" id="detGenero">-</div>
                    </div>
                    <div class="col-md-3">
                        <span class="frm-label">Estado Civil</span>
