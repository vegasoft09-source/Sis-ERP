@{
    ViewData["Title"] = "Recursos Humanos";
}

@section Styles {
    <!-- Reutilizamos forms.css para mantener la estructura limpia y premium -->
    <link rel="stylesheet" href="~/css/forms.css" />
    <!-- Agregamos los estilos específicos para RRHH -->
    <link rel="stylesheet" href="~/css/rrhh.css" />
}

<div class="frm-wrap rrhh-dashboard">
    <!-- Header de la sección -->
    <div class="frm-header rrhh-header">
        <div>
            <h1 class="frm-title">Recursos Humanos</h1>
            <p class="frm-subtitle">Gestión integral de personal, contratos, asistencias y ausencias</p>
        </div>
        <div class="frm-actions">
            <!-- Botón de Registro Rápido que abre el modal -->
            <button class="frm-btn-save" id="btnNuevoEmpleado" data-bs-toggle="modal" data-bs-target="#modalNuevoEmpleado">
                <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <line x1="19" y1="8" x2="19" y2="14"></line>
                    <line x1="22" y1="11" x2="16" y2="11"></line>
                </svg>
                Registrar Empleado
            </button>
        </div>
    </div>

    <!-- Indicadores / Analytics Premium -->
    <div class="frm-analytics">
        <div class="frm-analytic-item">
            <span class="frm-analytic-label">
                <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
                Empleados Activos
            </span>
            <span class="frm-analytic-value" id="kpiEmpleados">0</span>
        </div>
        <div class="frm-analytic-item">
            <span class="frm-analytic-label">
                <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                Contratos Activos
            </span>
            <span class="frm-analytic-value" id="kpiContratos">0</span>
        </div>
        <div class="frm-analytic-item">
            <span class="frm-analytic-label">
                <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                Asistencias Hoy
            </span>
            <span class="frm-analytic-value" id="kpiAsistencias">0</span>
        </div>
        <div class="frm-analytic-item">
            <span class="frm-analytic-label">
                <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                Ausencias Ptes.
            </span>
            <span class="frm-analytic-value" id="kpiAusencias">0</span>
        </div>
        <div class="frm-analytic-item">
            <span class="frm-analytic-label">
                <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                Departamentos
            </span>
            <span class="frm-analytic-value" id="kpiDepartamentos">0</span>
        </div>
        <div class="frm-analytic-item">
            <span class="frm-analytic-label">
                <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
                Cargos
            </span>
            <span class="frm-analytic-value" id="kpiCargos">0</span>
        </div>
    </div>

    <!-- Contenedor Principal (Tabs y Tablas) -->
    <div class="frm-panel-clean">
        <!-- Navegación por pestañas -->
        <div class="frm-tabs" id="rrhhTabs">
            <button class="frm-tab active" data-target="#tab-empleados">Directorio</button>
            <button class="frm-tab" data-target="#tab-departamentos">Departamentos</button>
            <button class="frm-tab" data-target="#tab-cargos">Cargos</button>
            <button class="frm-tab" data-target="#tab-contratos">Contratos</button>
            <button class="frm-tab" data-target="#tab-asistencia">Asistencia</button>
            <button class="frm-tab" data-target="#tab-ausencias">Ausencias</button>
        </div>

        <!-- Tab: Empleados -->
        <div id="tab-empleados" class="tab-content active">
            <div class="tab-section-header emp-header-wrap">
                <span class="tab-section-title">Directorio de Empleados</span>
                <div class="emp-toolbar">
                    <!-- Filtro rápido por estado -->
                    <div class="emp-filter-tags" id="empFilterTags">
                        <button class="emp-filter-tag active" data-filter="todos">
                            <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" width="14" height="14"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            Todos
                            <span class="emp-filter-count" id="countTodos">0</span>
                        </button>
                        <button class="emp-filter-tag" data-filter="activos">
                            <span class="emp-filter-dot dot-activo"></span>
                            Activos
                            <span class="emp-filter-count" id="countActivos">0</span>
                        </button>
                        <button class="emp-filter-tag" data-filter="inactivos">
                            <span class="emp-filter-dot dot-inactivo"></span>
                            Inactivos
                            <span class="emp-filter-count" id="countInactivos">0</span>
                        </button>
                    </div>
                    <!-- Campo de búsqueda -->
                    <div class="emp-search-box" id="empSearchBox">
                        <svg class="emp-search-icon" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text" class="emp-search-input" id="empSearchInput" placeholder="Buscar por nombre, departamento, cargo o documento..." autocomplete="off">
                        <button class="emp-search-clear" id="empSearchClear" title="Limpiar búsqueda" style="display:none;">
                            <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" width="16" height="16"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                    </div>
                </div>
            </div>
            <!-- Contador de resultados -->
            <div class="emp-results-bar" id="empResultsBar">
                <span id="empResultsText"></span>
            </div>
            <div class="table-responsive">
                <table class="frm-table-clean">
                    <thead>
                        <tr>
                            <th>Empleado</th>
                            <th>Departamento</th>
                            <th>Cargo</th>
                            <th>Documento</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbEmpleados">
    <!-- Llenado dinámicamente vía JS -->
    <!-- Template row for employee entries -->
    <tr class="employee-row-template d-none" data-id="">
        <td class="emp-name"></td>
        <td class="emp-dept"></td>
        <td class="emp-cargo"></td>
        <td class="emp-doc"></td>
        <td class="emp-estado"></td>
        <td>
            <button class="frm-btn-sm edit-emp" title="Editar">
    <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M12 20h9"/><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M12 11l5-5 2 2-5 5-2-2z"/></svg>
</button>
        </td>
    </tr>
</tbody>
                </table>
            </div>
        </div>
        
        <!-- Tab: Departamentos -->
        <div id="tab-departamentos" class="tab-content" style="display: none;">
            <div class="asis-toolbar card-premium mb-4 p-3">
                <div class="row g-3 align-items-center justify-content-between">
                    <div class="col-md-5 col-sm-6">
                        <label class="frm-label mb-1 text-muted small">Buscar Departamento</label>
                        <div class="emp-search-box w-100" style="max-width: 100%;">
                            <svg class="emp-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            <input type="text" id="deptSearchInput" class="emp-search-input" placeholder="Nombre del departamento...">
                            <button class="emp-search-clear" id="deptSearchClear" style="display: none;" title="Limpiar búsqueda">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-12 d-flex align-items-end justify-content-end">
                        <button class="frm-btn-save w-100" id="btnNuevoDepartamento">
                            <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" class="me-1">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            Nuevo Departamento
                        </button>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="frm-table-clean">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre del Departamento</th>
                            <th>Responsable</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbDepartamentos">
                        <!-- Llenado dinámicamente vía JS -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tab: Cargos -->
        <div id="tab-cargos" class="tab-content" style="display: none;">
            <div class="asis-toolbar card-premium mb-4 p-3">
                <div class="row g-3 align-items-center justify-content-between">
                    <div class="col-md-5 col-sm-6">
                        <label class="frm-label mb-1 text-muted small">Buscar Cargo</label>
                        <div class="emp-search-box w-100" style="max-width: 100%;">
                            <svg class="emp-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            <input type="text" id="cargoSearchInput" class="emp-search-input" placeholder="Nombre del cargo...">
                            <button class="emp-search-clear" id="cargoSearchClear" style="display: none;" title="Limpiar búsqueda">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-12 d-flex align-items-end justify-content-end">
                        <button class="frm-btn-save w-100" id="btnNuevoCargo" data-bs-toggle="modal" data-bs-target="#modalNuevoCargo">
                            <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" class="me-1">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            Nuevo Cargo
                        </button>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="frm-table-clean">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre del Cargo</th>
                            <th>Descripción</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbCargos">
                        <!-- Llenado dinámicamente vía JS -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tab: Contratos -->
        <div id="tab-contratos" class="tab-content" style="display: none;">
            
            <!-- VISTA: Contratos -->
            <div id="contratos-view-general" class="asis-view-section active">
                <!-- Toolbar y Filtros -->
                <div class="asis-toolbar card-premium mb-4 p-3">
                    <div class="row g-3 align-items-center justify-content-between">
                        <div class="col-md-5 col-sm-6">
                            <label class="frm-label mb-1 text-muted small">Buscar Contrato o Empleado</label>
                            <div class="emp-search-box w-100" style="max-width: 100%;">
                                <svg class="emp-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                <input type="text" id="contratosSearchInput" class="emp-search-input" placeholder="Nombre, empleado, departamento...">
                                <button class="emp-search-clear" id="contratosSearchClear" style="display: none;" title="Limpiar búsqueda">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-5 col-sm-12">
                            <label class="frm-label mb-1 text-muted small">Estado del Contrato</label>
                            <div class="emp-filter-tags mt-1" id="contratosFilterTags">
                                <button class="emp-filter-tag active" data-filter="todos">Todos</button>
                                <button class="emp-filter-tag" data-filter="activo">
                                    <div class="emp-filter-dot dot-activo"></div> Activos
                                </button>
                                <button class="emp-filter-tag" data-filter="finalizado">
                                    <div class="emp-filter-dot dot-inactivo"></div> Finalizados
                                </button>
                                <button class="emp-filter-tag" data-filter="anulado">
                                    <div class="emp-filter-dot" style="background: #ef4444; box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15);"></div> Anulados
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12 d-flex align-items-end justify-content-end">
                            <button class="frm-btn-save w-100" id="btnNuevoContrato">
                                <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" class="me-1">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                Nuevo Contrato
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Tabla de Contratos General -->
                <div class="table-responsive">
                    <table class="frm-table-clean">
                        <thead>
                            <tr>
                                <th>Empleado</th>
                                <th>Contrato</th>
                                <th>F. Inicio</th>
                                <th>F. Fin</th>
                                <th>Sueldo</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbContratosGeneral">
                            <tr><td colspan="7" class="text-center py-4 text-muted">Cargando contratos...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tab: Asistencia -->
        <div id="tab-asistencia" class="tab-content" style="display: none;">
            
            <!-- VISTA ÚNICA: Panel General -->
            <div id="asis-view-general" class="asis-view-section active">
                
                <!-- Toolbar y Filtros -->
                <div class="asis-toolbar card-premium mb-4 p-3">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-2 col-sm-6">
                            <label class="frm-label mb-1 text-muted small">Fecha de Consulta</label>
                            <input type="date" class="frm-input asis-date-picker" id="asisGeneralFecha">
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <label class="frm-label mb-1 text-muted small">Buscar Empleado</label>
                            <div class="emp-search-box w-100" style="max-width: 100%;">
                                <svg class="emp-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                <input type="text" id="asisSearchInput" class="emp-search-input" placeholder="Nombre o departamento...">
                                <button class="emp-search-clear" id="asisSearchClear" style="display: none;" title="Limpiar búsqueda">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-5 col-sm-12">
                            <label class="frm-label mb-1 text-muted small">Estado de Marcación</label>
                            <div class="emp-filter-tags mt-1" id="asisFilterTags">
                                <button class="emp-filter-tag active" data-filter="todos">Todos</button>
                                <button class="emp-filter-tag" data-filter="completa">
                                    <div class="emp-filter-dot dot-activo"></div> Completa
                                </button>
                                <button class="emp-filter-tag" data-filter="en_curso">
                                    <div class="emp-filter-dot" style="background: #eab308; box-shadow: 0 0 0 3px rgba(234, 179, 8, 0.15);"></div> En Curso
                                </button>
                                <button class="emp-filter-tag" data-filter="sin_registro">
                                    <div class="emp-filter-dot dot-inactivo"></div> Sin Registro
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <label class="frm-label mb-1 text-muted small d-block">&nbsp;</label>
                            <button class="frm-btn-save w-100" onclick="abrirModalNuevaAsistencia()">
                                <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" width="16" height="16" class="me-1"><path d="M12 5v14M5 12h14"/></svg>
                                Nueva Asistencia
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Mini KPIs Asistencia -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3 col-sm-6">
                        <div class="asis-kpi-card">
                            <div class="kpi-icon text-primary bg-primary bg-opacity-10">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                            </div>
                            <div class="kpi-data">
                                <div class="kpi-value" id="kpiAsisTotal">0</div>
                                <div class="kpi-label">Total Empleados</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="asis-kpi-card">
                            <div class="kpi-icon text-success bg-success bg-opacity-10">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            </div>
                            <div class="kpi-data">
                                <div class="kpi-value" id="kpiAsisPresentes">0</div>
                                <div class="kpi-label">Presentes (En curso + Completa)</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="asis-kpi-card">
                            <div class="kpi-icon text-danger bg-danger bg-opacity-10">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                            </div>
                            <div class="kpi-data">
                                <div class="kpi-value" id="kpiAsisAusentes">0</div>
                                <div class="kpi-label">Sin Registro</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="asis-kpi-card">
                            <div class="kpi-icon text-warning bg-warning bg-opacity-10">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            </div>
                            <div class="kpi-data">
                                <div class="kpi-value" id="kpiAsisPromedio">0.0h</div>
                                <div class="kpi-label">Promedio Horas</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabla de Asistencia General -->
                <div class="table-responsive">
                    <table class="frm-table-clean">
                        <thead>
                            <tr>
                                <th>Empleado</th>
                                <th>Departamento</th>
                                <th>Entrada</th>
