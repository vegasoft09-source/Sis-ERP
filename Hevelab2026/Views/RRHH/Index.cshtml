                    </div>
                    <div class="col-md-3">
                        <span class="frm-label">Teléfono</span>
                        <div class="det-val" id="detTelefono">-</div>
                    </div>
                    <div class="col-md-3">
                        <span class="frm-label">Celular</span>
                        <div class="det-val" id="detCelular">-</div>
                    </div>
                    <div class="col-md-6">
                        <span class="frm-label">Correo Personal</span>
                        <div class="det-val" id="detCorreoPersonal">-</div>
                    </div>
                    <div class="col-md-6">
                        <span class="frm-label">Correo Empresa</span>
                        <div class="det-val" id="detCorreoEmpresa">-</div>
                    </div>
                    <div class="col-md-12">
                        <span class="frm-label">Dirección</span>
                        <div class="det-val" id="detDireccion">-</div>
                    </div>
                    <div class="col-md-3">
                        <span class="frm-label">Departamento</span>
                        <div class="det-val" id="detDepartamento">-</div>
                    </div>
                    <div class="col-md-3">
                        <span class="frm-label">Cargo</span>
                        <div class="det-val" id="detCargoDetalle">-</div>
                    </div>
                    <div class="col-md-3">
                        <span class="frm-label">Responsable</span>
                        <div class="det-val" id="detResponsable">-</div>
                    </div>
                    <div class="col-md-3">
                        <span class="frm-label">Usuario Asociado</span>
                        <div class="det-val" id="detUsuarioId">-</div>
                    </div>
                    <div class="col-md-3">
                        <span class="frm-label">Fecha de Ingreso</span>
                        <div class="det-val" id="detFechaIngreso">-</div>
                    </div>
                    <div class="col-md-3">
                        <span class="frm-label">Fecha de Cese</span>
                        <div class="det-val" id="detFechaCese">-</div>
                    </div>
                    <div class="col-md-3">
                        <span class="frm-label">Tipo de Contrato</span>
                        <div class="det-val" id="detTipoContrato">-</div>
                    </div>
                    <div class="col-md-3">
                        <span class="frm-label">Régimen Laboral</span>
                        <div class="det-val" id="detRegimenLaboral">-</div>
                    </div>
                    <div class="col-md-12 mt-2">
                        <span class="frm-label">Estado actual</span>
                        <div class="det-val" id="detEstado">-</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                <button type="button" class="frm-btn-cancel" data-bs-dismiss="modal">Cerrar Ficha</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Editar Asistencia -->
<div class="modal fade" id="modalEditarAsistencia" tabindex="-1" aria-labelledby="modalEditarAsistenciaLabel" aria-hidden="true" data-bs-theme="light">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: var(--radius-lg); border: 1px solid var(--border-color);">
            <div class="modal-header" style="background: var(--bg-app); border-bottom: 1px solid var(--border-color);">
                <h5 class="modal-title" id="modalEditarAsistenciaLabel" style="font-weight: 700;">Editar Asistencia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="frmEditarAsistencia">
                <input type="hidden" id="asistenciaId" value="">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="frm-label">Fecha</label>
                            <input type="date" class="frm-input" id="asistenciaEditFecha" required>
                        </div>
                        <div class="col-md-6">
                            <label class="frm-label">Hora de Entrada</label>
                            <input type="time" class="frm-input" id="asistenciaEditEntrada" step="1" required>
                        </div>
                        <div class="col-md-6">
                            <label class="frm-label">Hora de Salida</label>
                            <input type="time" class="frm-input" id="asistenciaEditSalida" step="1">
                        </div>
                        <div class="col-12">
                            <label class="frm-label">Observaciones</label>
                            <textarea class="frm-input" id="asistenciaEditObservaciones" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                    <button type="button" class="frm-btn-cancel" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="frm-btn-save">
                        <i class="ph ph-floppy-disk me-2"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Nueva Asistencia (Manual) -->
<div class="modal fade" id="modalNuevaAsistencia" tabindex="-1" aria-labelledby="modalNuevaAsistenciaLabel" aria-hidden="true" data-bs-theme="light">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: var(--radius-lg); border: 1px solid var(--border-color); background: #f8fafc;">
            <div class="modal-header" style="background: var(--bg-app); border-bottom: 1px solid var(--border-color);">
                <h5 class="modal-title m-0" id="modalNuevaAsistenciaLabel" style="font-weight: 700;">Registrar Asistencia Manual</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="frmNuevaAsistencia">
                <div class="modal-body p-4">
                    <div class="frm-field frm-field--full mb-3">
                        <label class="frm-label">Empleado <span class="text-danger">*</span></label>
                        <select class="frm-input" id="asistenciaSelectEmpleado" required>
                            <option value="">Cargando empleados...</option>
                        </select>
                    </div>
                    <div class="frm-field frm-field--full mb-3">
                        <label class="frm-label">Fecha <span class="text-danger">*</span></label>
                        <input type="date" class="frm-input" id="asistenciaManualFecha" required>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="frm-label">Hora Entrada <span class="text-danger">*</span></label>
                            <input type="time" class="frm-input" id="asistenciaManualEntrada" required>
                        </div>
                    </div>
                    <div class="frm-field frm-field--full mb-0">
                        <label class="frm-label">Observaciones</label>
                        <textarea class="frm-input" id="asistenciaManualObservaciones" rows="2" placeholder="Detalles sobre el registro..."></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                    <button type="button" class="frm-btn-cancel" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="frm-btn-save">
                        <i class="ph ph-floppy-disk me-2"></i> Guardar Asistencia
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/rrhh.js"></script>
}
