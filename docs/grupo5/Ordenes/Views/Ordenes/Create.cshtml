@model Hevelab2026.Models.OrdenVenta

@{
    ViewData["Title"] = "Nueva Orden de Venta";
    ViewData["Breadcrumbs"] = new[] {
        ("Dashboard", "/"),
        ("Ventas", "#"),
        ("Órdenes", "/Ordenes"),
        ("Nueva Orden", "")
    };
}

<div class="frm-wrap">
    <div class="frm-header mb-4">
        <a href="/Ordenes" class="frm-back">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
        <div>
            <h1 class="frm-title">Nueva Orden de Venta</h1>
            <p class="frm-subtitle">Completa los datos para registrar una orden de venta</p>
        </div>
    </div>

    <form method="post" action="/Ordenes/Create">
        @Html.AntiForgeryToken()
        
        <div class="frm-card mb-4">
            <div class="frm-card-head">
                <span class="frm-card-num">1</span>
                Datos del Cliente
            </div>
            <div class="frm-card-body">
                <div class="frm-grid">
                    <div class="frm-field frm-field--half">
                        <label class="frm-label">Número de Pedido</label>
                        <input type="text" class="frm-input" placeholder="Autogenerado al guardar" disabled />
                    </div>
                    <div class="frm-field frm-field--half">
                        <label class="frm-label">Fecha de Creación</label>
                        <input type="date" name="FechaCreacion" class="frm-input" value="@Model.FechaCreacion.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="frm-field frm-field--third">
                        <label class="frm-label">Cliente</label>
                        <input type="text" name="Cliente" class="frm-input" required />
                    </div>
                    <div class="frm-field frm-field--third">
                        <label class="frm-label">Razón Social</label>
                        <input type="text" name="RazonSocial" class="frm-input" />
                    </div>
                    <div class="frm-field frm-field--third">
                        <label class="frm-label">RUC</label>
                        <input type="text" name="Ruc" class="frm-input" />
                    </div>
                </div>
            </div>
        </div>

        <div class="frm-card mb-4">
            <div class="frm-card-head">
                <span class="frm-card-num">2</span>
                Condiciones Comerciales
            </div>
            <div class="frm-card-body">
                <div class="frm-grid">
                    <div class="frm-field frm-field--third">
                        <label class="frm-label">Moneda</label>
                        <select name="Moneda" class="frm-input frm-select">
                            <option value="PEN">Soles (PEN)</option>
                            <option value="USD">Dólares (USD)</option>
                        </select>
                    </div>
                    <div class="frm-field frm-field--third">
                        <label class="frm-label">Condición de Pago</label>
                        <select name="CondicionPago" class="frm-input frm-select">
                            <option value="Contado">Contado</option>
                            <option value="Crédito 15 días">Crédito 15 días</option>
                            <option value="Crédito 30 días">Crédito 30 días</option>
                            <option value="Crédito 60 días">Crédito 60 días</option>
                        </select>
                    </div>
                    <div class="frm-field frm-field--third">
                        <label class="frm-label">Vendedor</label>
                        <input type="text" name="Vendedor" class="frm-input" />
                    </div>
                </div>
            </div>
        </div>

        <div class="frm-card mb-4">
            <div class="frm-card-head">
                <span class="frm-card-num">3</span>
                Detalle de Productos y Servicios
            </div>
            <div class="frm-card-body" style="padding: 0;">
                <table class="frm-table-clean">
                    <thead>
                        <tr>
                            <th style="width: 50px;">ITEM</th>
                            <th style="width: 100px;">CÓDIGO</th>
                            <th>DESCRIPCIÓN</th>
                            <th style="text-align:right;">CANTIDAD</th>
                            <th style="text-align:right;">PRECIO UNIT.</th>
                            <th style="text-align:right;">IMPORTE</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="tbody-items">
                        <tr>
                            <td colspan="7" style="text-align:center; color:var(--text-muted); font-style:italic;">No hay productos agregados</td>
                        </tr>
                    </tbody>
                </table>
                <div style="padding: 15px; border-bottom: 1px solid var(--border-color); display: flex; gap: 20px;">
                    <button type="button" onclick="addMockItem('producto')" style="background:none; border:none; color:var(--sys-primary); font-size:11px; font-weight:800; text-transform:uppercase; display:flex; align-items:center; gap:5px; cursor:pointer;">
                        <svg viewBox="0 0 24 24" style="width:14px; height:14px; stroke:currentColor; fill:none; stroke-width:2;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg> AGREGAR UN PRODUCTO
                    </button>
                    <button type="button" onclick="addMockItem('seccion')" style="background:none; border:none; color:var(--sys-primary); font-size:11px; font-weight:800; text-transform:uppercase; display:flex; align-items:center; gap:5px; cursor:pointer;">
                        <svg viewBox="0 0 24 24" style="width:14px; height:14px; stroke:currentColor; fill:none; stroke-width:2;"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg> AGREGAR UNA SECCIÓN
                    </button>
                    <button type="button" onclick="addMockItem('nota')" style="background:none; border:none; color:var(--sys-primary); font-size:11px; font-weight:800; text-transform:uppercase; display:flex; align-items:center; gap:5px; cursor:pointer;">
                        <svg viewBox="0 0 24 24" style="width:14px; height:14px; stroke:currentColor; fill:none; stroke-width:2;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> AGREGAR UNA NOTA
                    </button>
                    <button type="button" onclick="alert('Abriendo catálogo...')" style="background:none; border:none; color:var(--sys-primary); font-size:11px; font-weight:800; text-transform:uppercase; display:flex; align-items:center; gap:5px; cursor:pointer;">
                        <svg viewBox="0 0 24 24" style="width:14px; height:14px; stroke:currentColor; fill:none; stroke-width:2;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg> CATÁLOGO
                    </button>
                </div>
            </div>
        </div>

        <div class="frm-card mb-4">
            <div class="frm-card-head">
                <span class="frm-card-num">4</span>
                Montos y Totales
            </div>
            <div class="frm-card-body">
                <div class="frm-grid">
                    <div class="frm-field frm-field--third">
                        <label class="frm-label">Subtotal</label>
                        <input type="number" name="Subtotal" class="frm-input" step="0.01" value="@(Model.Subtotal == 0 ? "0.00" : Model.Subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                    </div>
                    <div class="frm-field frm-field--third">
                        <label class="frm-label">Descuento</label>
                        <input type="number" name="Descuento" class="frm-input" step="0.01" value="@(Model.Descuento == 0 ? "0.00" : Model.Descuento.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                    </div>
                    <div class="frm-field frm-field--third">
                        <label class="frm-label">Impuestos</label>
                        <input type="number" name="Impuestos" class="frm-input" step="0.01" value="@(Model.Impuestos == 0 ? "0.00" : Model.Impuestos.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                    </div>
                    <div class="frm-field frm-field--third">
                        <label class="frm-label">Total</label>
                        <input type="number" name="Total" class="frm-input" step="0.01" value="@(Model.Total == 0 ? "0.00" : Model.Total.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                    </div>
                    <div class="frm-field frm-field--third">
                        <label class="frm-label">Estado</label>
                        <select name="Estado" class="frm-input frm-select">
                            <option value="BORRADOR">BORRADOR</option>
                            <option value="POR FACTURAR">POR FACTURAR</option>
                            <option value="FACTURADO POR COMPLETO">FACTURADO POR COMPLETO</option>
                        </select>
                    </div>
                    <div class="frm-field frm-field--full">
                        <label class="frm-label">Notas</label>
                        <input type="text" name="Notas" class="frm-input" value="@Model.Notas" />
                    </div>
                </div>
            </div>
        </div>

        <div class="frm-actions mb-5">
            <a href="/Ordenes" class="frm-btn-cancel">Cancelar</a>
            <button type="submit" class="frm-btn-save">
                <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Registrar Orden
            </button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    let mockItemId = 0;
    function addMockItem(type) {
        const tbody = document.getElementById('tbody-items');
        if (tbody.querySelector('td[colspan="7"]')) {
            tbody.innerHTML = '';
        }
        
        const tr = document.createElement('tr');
        if (type === 'producto') {
            tr.innerHTML = `
                <td>${mockItemId + 1}<input type="hidden" name="Items[${mockItemId}].Tipo" value="producto" /></td>
                <td><input type="text" name="Items[${mockItemId}].Codigo" class="frm-input" placeholder="PRD-00X" style="height:28px; font-size:12px;"></td>
                <td><input type="text" name="Items[${mockItemId}].Descripcion" class="frm-input" placeholder="Descripción" style="height:28px; font-size:12px;"></td>
                <td><input type="number" name="Items[${mockItemId}].Cantidad" value="1" class="frm-input item-qty" style="height:28px; font-size:12px; text-align:right;" oninput="calcTotals()"></td>
                <td><input type="number" name="Items[${mockItemId}].PrecioUnitario" value="100.00" class="frm-input item-price" style="height:28px; font-size:12px; text-align:right;" oninput="calcTotals()"></td>
                <td style="text-align:right; font-weight:800;" class="item-total">100.00<input type="hidden" name="Items[${mockItemId}].Importe" value="100.00" class="item-importe" /><input type="hidden" name="Items[${mockItemId}].PrecioIgv" value="18.00" class="item-igv" /></td>
                <td><button type="button" onclick="this.closest('tr').remove(); calcTotals();" style="border:none;background:none;color:red;">x</button></td>
            `;
            mockItemId++;
        } else if (type === 'seccion') {
            tr.innerHTML = `
                <td colspan="7" style="background: #f1f5f9; font-weight: 800; color: var(--sys-primary); text-transform: uppercase;">
                    <input type="hidden" name="Items[${mockItemId}].Tipo" value="seccion" />
                    <input type="text" name="Items[${mockItemId}].Descripcion" class="frm-input" placeholder="NOMBRE DE SECCIÓN" style="height:28px; font-size:12px; background:transparent; border:none; font-weight:bold;">
                </td>
            `;
            mockItemId++;
        } else if (type === 'nota') {
            tr.innerHTML = `
                <td colspan="7" style="font-style: italic; color: #e11d48; text-align: center;">
                    <input type="hidden" name="Items[${mockItemId}].Tipo" value="nota" />
                    <input type="text" name="Items[${mockItemId}].Descripcion" class="frm-input" placeholder="* Escriba una nota aquí..." style="height:28px; font-size:12px; border:none; text-align:center; color:#e11d48;">
                </td>
            `;
            mockItemId++;
        }
        tbody.appendChild(tr);
        calcTotals();
    }

    function calcTotals() {
        const tbody = document.getElementById('tbody-items');
        let subtotal = 0;
        
        tbody.querySelectorAll('tr').forEach(tr => {
            const qtyInput = tr.querySelector('.item-qty');
            const priceInput = tr.querySelector('.item-price');
            const totalTd = tr.querySelector('.item-total');
            const importeHidden = tr.querySelector('.item-importe');
            const igvHidden = tr.querySelector('.item-igv');
            
            if(qtyInput && priceInput && totalTd) {
                const qty = parseFloat(qtyInput.value) || 0;
                const price = parseFloat(priceInput.value) || 0;
                const rowTotal = qty * price;
                const rowIgv = rowTotal * 0.18;
                
                totalTd.childNodes[0].nodeValue = rowTotal.toFixed(2);
                if (importeHidden) importeHidden.value = rowTotal.toFixed(2);
                if (igvHidden) igvHidden.value = rowIgv.toFixed(2);
                
                subtotal += rowTotal;
            }
        });
        
        const igv = subtotal * 0.18;
        const total = subtotal + igv;
        
        document.querySelector('input[name="Subtotal"]').value = subtotal.toFixed(2);
        document.querySelector('input[name="Impuestos"]').value = igv.toFixed(2);
        document.querySelector('input[name="Total"]').value = total.toFixed(2);
    }
</script>
}