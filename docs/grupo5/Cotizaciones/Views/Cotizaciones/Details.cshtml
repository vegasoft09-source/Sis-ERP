@model Hevelab2026.Models.Cotizacion

@{
    ViewData["Title"] = "Detalle Cotización";
}

<div class="frm-wrap" style="max-width: 1100px;">
    
    <!-- Topbar: Back & Icons -->
    <div class="no-print" style="display:flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <div style="display: flex; align-items: center; gap: 15px;">
            <a href="/Cotizaciones" class="frm-back no-print" style="background: transparent; border: none; font-weight: 800; color: var(--sys-primary);">
                <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                REGRESAR
            </a>
            <div style="color: var(--text-muted); display: flex; gap: 10px;">
                <svg viewBox="0 0 24 24" style="width:16px; height:16px; stroke:currentColor; fill:none; stroke-width:2;"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                <svg viewBox="0 0 24 24" style="width:16px; height:16px; stroke:currentColor; fill:none; stroke-width:2;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </div>
        </div>
        
        <div class="frm-stepper">
            <span class="frm-step active">COTIZACIÓN</span>
            <span class="frm-step" style="color: var(--border-color);">COTIZACIÓN ENVIADA</span>
            <span class="frm-step" style="color: var(--border-color);">ORDEN DE VENTA</span>
        </div>
    </div>

    <!-- Botonera -->
    <div class="no-print" style="display: flex; gap: 10px; margin-bottom: 25px; align-items: center;">
        <a href="/Cotizaciones/ConvertirAOrden/@Model.Id" class="frm-btn-save" style="background: #3730a3; border-radius: 8px; text-decoration: none;">
            <svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
            Convertir a Orden
        </a>
        <button type="button" class="frm-btn-cancel" style="background: #f1f5f9; border: none; font-weight: 700; color: #475569; border-radius: 8px;" onclick="alert('Cotización enviada al cliente por correo.')">
            <svg viewBox="0 0 24 24" style="width:16px; height:16px; stroke:currentColor; fill:none; stroke-width:2; margin-right:5px;"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            Enviar
        </button>
        <button type="button" class="frm-btn-cancel" style="background: #f1f5f9; border: none; font-weight: 700; color: #475569; border-radius: 8px;" onclick="window.print()">
            <svg viewBox="0 0 24 24" style="width:16px; height:16px; stroke:currentColor; fill:none; stroke-width:2; margin-right:5px;"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Imprimir
        </button>
        <a href="#" style="color: #e11d48; font-weight: 700; font-size: 13px; text-decoration: none; margin-left: 10px; display: flex; align-items: center; gap: 5px;">
            <svg viewBox="0 0 24 24" style="width:16px; height:16px; stroke:currentColor; fill:none; stroke-width:2;"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            Cancelar
        </a>
    </div>

    <!-- Main Panel -->
    <div class="frm-panel-clean">
        
        <!-- Headers Info -->
        <div style="display: flex; justify-content: space-between; margin-bottom: 40px;">
            <div>
                <div style="margin-bottom: 20px;">
                    <div class="frm-label">ID DE COTIZACIÓN</div>
                    <div style="font-size: 24px; font-weight: 800; color: #3730a3;">@Model.NumeroPedido</div>
                </div>

                <div style="margin-bottom: 15px;">
                    <div class="frm-label">CLIENTE</div>
                    <div style="font-size: 13px; font-weight: 700; color: var(--text-primary);">@Model.RazonSocial</div>
                </div>

                <div style="margin-bottom: 15px;">
                    <div class="frm-label">RUC</div>
                    <div style="font-size: 13px; font-weight: 700; color: var(--text-primary);">@Model.RUC</div>
                </div>

                <div style="margin-bottom: 15px;">
                    <div class="frm-label">DIRECCIÓN</div>
                    <div style="font-size: 13px; font-weight: 700; color: var(--text-primary);">@(string.IsNullOrEmpty(Model.Direccion) ? "Av. Reforma 405, Ciudad de México" : Model.Direccion)</div>
                </div>

                <div>
                    <div class="frm-label">FECHA DE EMISIÓN</div>
                    <div style="font-size: 13px; font-weight: 700; color: var(--text-primary);">@Model.FechaCreacion.ToString("dd 'de' MMMM, yyyy")</div>
                </div>
            </div>

            <div style="min-width: 300px;">
                <div style="margin-bottom: 25px;">
                    <div class="frm-label">MÉTODO DE PAGO</div>
                    <div style="font-size: 13px; font-weight: 700; color: var(--text-primary);">@Model.MetodoPago</div>
                </div>

                <div style="margin-bottom: 25px;">
                    <div class="frm-label">MONEDA</div>
                    <div style="font-size: 13px; font-weight: 700; color: var(--text-primary);">@Model.Moneda</div>
                </div>

                <div>
                    <div class="frm-label">VENDEDOR</div>
                    <div style="font-size: 13px; font-weight: 700; color: var(--text-primary);">@Model.Vendedor</div>
                </div>
            </div>
        </div>

        <!-- Productos y Servicios -->
        <div>
            <div class="frm-label" style="margin-bottom: 15px; color: var(--sys-primary); font-size: 12px;">DETALLE DE PRODUCTOS Y SERVICIOS</div>
            
            <table class="frm-table-clean">
                <thead>
                    <tr>
                        <th style="width: 50px;">ITEM</th>
                        <th style="width: 100px;">CÓDIGO</th>
                        <th>DESCRIPCIÓN</th>
                        <th style="text-align:right;">STOCK</th>
                        <th style="text-align:right;">CANTIDAD</th>
                        <th style="text-align:right;">DESCUENTO</th>
                        <th>UNIDAD</th>
                        <th style="text-align:right;">PRECIO UNITARIO</th>
                        <th style="text-align:right;">PRECIO IGV</th>
                        <th style="text-align:right;">IMPORTE</th>
                    </tr>
                </thead>
                <tbody id="tbody-items">
                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <!-- Datos de ejemplo de la captura -->
                        <tr>
                            <td>1</td>
                            <td style="font-weight: 700; color: #4338ca;">MAT-0092</td>
                            <td>
                                <div style="font-weight: 700; color: var(--text-primary);">Vigueta de Acero Estructural</div>
                                <div style="font-size: 11px; color: var(--text-muted);">Calibre 14, 6m galvanizado</div>
                            </td>
                            <td style="text-align:right;">150.00</td>
                            <td style="text-align:right; font-weight:700;">50 <svg viewBox="0 0 24 24" style="width:12px; height:12px; fill:none; stroke:currentColor; stroke-width:2;"><polyline points="7 10 12 15 17 10"/></svg></td>
                            <td style="text-align:right;">0.00%</td>
                            <td>UND</td>
                            <td style="text-align:right; font-weight:700;">$1,240</td>
                            <td style="text-align:right;">$9,920.00</td>
                            <td style="text-align:right; font-weight:800; color:var(--text-primary);">S/ 62,000.00</td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td style="font-weight: 700; color: #4338ca;">CON-0155</td>
                            <td>
                                <div style="font-weight: 700; color: var(--text-primary);">Concreto Premezclado f'c=250</div>
                                <div style="font-size: 11px; color: var(--text-muted);">Resistencia estándar, con bomba</div>
                            </td>
                            <td style="text-align:right;">500.00</td>
                            <td style="text-align:right; font-weight:700;">12 <svg viewBox="0 0 24 24" style="width:12px; height:12px; fill:none; stroke:currentColor; stroke-width:2;"><polyline points="7 10 12 15 17 10"/></svg></td>
                            <td style="text-align:right;">5.00%</td>
                            <td>M3</td>
                            <td style="text-align:right; font-weight:700;">$2,150</td>
                            <td style="text-align:right;">$3,921.60</td>
                            <td style="text-align:right; font-weight:800; color:var(--text-primary);">S/ 24,510.00</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div style="padding: 15px; border-bottom: 1px solid var(--border-color); display: flex; gap: 20px;">
                <button type="button" onclick="addMockItem('producto')" style="background:none; border:none; color:var(--sys-primary); font-size:11px; font-weight:800; text-transform:uppercase; display:flex; align-items:center; gap:5px; cursor:pointer;">
                    <svg viewBox="0 0 24 24" style="width:14px; height:14px; stroke:currentColor; fill:none; stroke-width:2;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg> AGREGAR UN PRODUCTO
                </button>
                <button type="button" onclick="addMockItem('seccion')" style="background:none; border:none; color:var(--sys-primary); font-size:11px; font-weight:800; text-transform:uppercase; display:flex; align-items:center; gap:5px; cursor:pointer;">
                    <svg viewBox="0 0 24 24" style="width:14px; height:14px; stroke:currentColor; fill:none; stroke-width:2;"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg> AGREGAR UNA SECCIÓN
                </button>
                <button type="button" onclick="addMockItem('nota')" style="background:none; border:none; color:var(--sys-primary); font-size:11px; font-weight:800; text-transform:uppercase; display:flex; align-items:center; gap:5px; cursor:pointer;">
                    <svg viewBox="0 0 24 24" style="width:14px; height:14px; stroke:currentColor; fill:none; stroke-width:2;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> AGREGAR UNA NOTA
                </button>
                <button type="button" onclick="alert('Abriendo catálogo de productos...')" style="background:none; border:none; color:var(--sys-primary); font-size:11px; font-weight:800; text-transform:uppercase; display:flex; align-items:center; gap:5px; cursor:pointer;">
                    <svg viewBox="0 0 24 24" style="width:14px; height:14px; stroke:currentColor; fill:none; stroke-width:2;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg> CATÁLOGO
                </button>
            </div>
        </div>

        <!-- Totales y Notas -->
        <div style="display: flex; justify-content: space-between; margin-top: 30px;">
            <div style="flex: 1; padding-right: 40px;">
                <div class="frm-notes-card">
                    <h4>NOTAS IMPORTANTES</h4>
                    <p>Los precios mostrados no incluyen flete fuera del área metropolitana. La entrega se realiza en un período de 3 a 5 días hábiles una vez confirmado el anticipo del 50%. Vigencia de cotización: 15 días.</p>
                </div>
            </div>
            
            <div style="width: 300px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:10px;">
                    <span style="font-size:13px; font-weight:700; color:var(--text-secondary);">Subtotal:</span>
                    <span style="font-size:13px; font-weight:800; color:var(--text-primary);">@(Model.Moneda == "PEN" ? "S/" : "$") @Model.Subtotal.ToString("N2")</span>
                </div>
                <div style="display:flex; justify-content:space-between; margin-bottom:10px;">
                    <span style="font-size:13px; font-weight:700; color:var(--text-secondary);">IVA / IGV (18%):</span>
                    <span style="font-size:13px; font-weight:800; color:var(--text-primary);">@(Model.Moneda == "PEN" ? "S/" : "$") @Model.Impuestos.ToString("N2")</span>
                </div>
                <div style="display:flex; justify-content:space-between; margin-bottom:20px;">
                    <span style="font-size:13px; font-weight:700; color:var(--text-secondary);">Retención:</span>
                    <span style="font-size:13px; font-weight:800; color:var(--text-primary);">S/ 0.00</span>
                </div>

                <div style="background: #eef2ff; padding: 15px 20px; border-radius: 12px; display:flex; justify-content:space-between; align-items:center;">
                    <span style="font-size:12px; font-weight:800; color:#4338ca; text-transform:uppercase;">TOTAL COTIZADO</span>
                    <span style="font-size:22px; font-weight:900; color:#312e81;">@(Model.Moneda == "PEN" ? "S/" : "$") @Model.Total.ToString("N2")</span>
                </div>
            </div>
        </div>

    </div>

    <!-- Edit Link in details -->
    <div style="margin-top: 20px; text-align:right;">
        <span style="font-size:10px; color:var(--text-muted); font-style:italic; text-transform:uppercase;">DOCUMENTO GENERADO DIGITALMENTE POR HEVELAB ERP - @Model.NumeroPedido</span>
    </div>
</div>

@section Scripts {
<script>
    let mockItemId = 3;
    function addMockItem(type) {
        const tbody = document.getElementById('tbody-items');
        const tr = document.createElement('tr');
        
        if (type === 'producto') {
            tr.innerHTML = `
                <td>${mockItemId++}</td>
                <td style="font-weight: 700; color: #4338ca;">PRD-00${mockItemId}</td>
                <td>
                    <div style="font-weight: 700; color: var(--text-primary);">Producto Nuevo</div>
                    <div style="font-size: 11px; color: var(--text-muted);">Descripción genérica del producto agregado</div>
                </td>
                <td style="text-align:right;">100.00</td>
                <td style="text-align:right; font-weight:700;">10 <svg viewBox="0 0 24 24" style="width:12px; height:12px; fill:none; stroke:currentColor; stroke-width:2;"><polyline points="7 10 12 15 17 10"/></svg></td>
                <td style="text-align:right;">0.00%</td>
                <td>UND</td>
                <td style="text-align:right; font-weight:700;">$100</td>
                <td style="text-align:right;">$118.00</td>
                <td style="text-align:right; font-weight:800; color:var(--text-primary);">S/ 1,180.00</td>
            `;
        } else if (type === 'seccion') {
            tr.innerHTML = `
                <td colspan="10" style="background: #f1f5f9; font-weight: 800; color: var(--sys-primary); text-transform: uppercase;">
                    NUEVA SECCIÓN AGREGADA
                </td>
            `;
        } else if (type === 'nota') {
            tr.innerHTML = `
                <td colspan="10" style="font-style: italic; color: #e11d48; text-align: center;">
                    * Nota importante: Revisar condiciones de entrega para este ítem.
                </td>
            `;
        }
        
        tbody.appendChild(tr);
    }
</script>
}
