@model Hevelab2026.Models.Cotizacion
@using System.Globalization
@using System.Text.Json

@{
    var modo      = ViewBag.Modo as string ?? "create";
    var esDetalle = modo == "details";
    var esEditar  = modo == "edit";
    var cultura   = new CultureInfo("es-MX");

    var fecha = Model.FechaCreacion != default
        ? Model.FechaCreacion
        : (ViewBag.FechaEmision as DateTime? ?? DateTime.Now);
    var fechaTexto = fecha.ToString("d 'de' MMMM, yyyy", cultura);

    var formAction = esEditar ? "/Cotizaciones/Edit" : "/Cotizaciones/Create";
    var itemsJson  = JsonSerializer.Serialize(Model.Items ?? new List<CotizacionItem>());
}

<div class="cot-create@(esDetalle ? " cot-create--readonly" : "")" data-cot-mode="@modo">

    <div class="cot-create__top">
        <a href="/Cotizaciones" class="cot-create__back">
            <svg viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
        </a>
        <div class="cot-create__actions-top">
            @if (esDetalle)
            {
                <a href="/Cotizaciones" class="cot-create__btn cot-create__btn--ghost">Volver al listado</a>
                <a href="/Cotizaciones/Edit/@Model.Id" class="cot-create__btn cot-create__btn--primary">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    Editar Cotización
                </a>
            }
            else
            {
                <a href="/Cotizaciones" class="cot-create__btn cot-create__btn--ghost">Cancelar</a>
                <button type="submit" form="cotForm" class="cot-create__btn cot-create__btn--primary">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    @(esEditar ? "Guardar Cambios" : "Guardar Cotización")
                </button>
            }
        </div>
    </div>

    @if (esDetalle)
    {
        <div id="cotForm">
            @await Html.PartialAsync("_CotizacionCampos", Model)
        </div>
    }
    else
    {
        <form id="cotForm" method="post" action="@formAction" autocomplete="off">
            @Html.AntiForgeryToken()
            @if (esEditar)
            {
                <input type="hidden" name="Id" value="@Model.Id" />
                <input type="hidden" name="NumeroPedido" value="@Model.NumeroPedido" />
                <input type="hidden" name="FechaCreacion" value="@fecha.ToString("yyyy-MM-dd")" />
            }
            else
            {
                <input type="hidden" name="Estado" value="Pendiente" />
                <input type="hidden" name="FechaCreacion" value="@fecha.ToString("yyyy-MM-dd")" />
            }
            <input type="hidden" name="Subtotal" id="hidSubtotal" value="@Model.Subtotal.ToString(CultureInfo.InvariantCulture)" />
            <input type="hidden" name="Impuestos" id="hidImpuestos" value="@Model.Impuestos.ToString(CultureInfo.InvariantCulture)" />
            <input type="hidden" name="Total" id="hidTotal" value="@Model.Total.ToString(CultureInfo.InvariantCulture)" />
            <input type="hidden" name="Descuento" value="@Model.Descuento.ToString(CultureInfo.InvariantCulture)" />
            @await Html.PartialAsync("_CotizacionCampos", Model)
            <input type="hidden" name="RazonSocial" id="cotRazonSocial" value="@Model.RazonSocial" />
        </form>
    }

    @if (!esDetalle)
    {
        <div id="cotCatalogModal" class="cot-create__modal-overlay">
            <div class="cot-create__modal">
                <div class="cot-create__modal-head">
                    <h3>Catálogo de Productos y Servicios</h3>
                    <button type="button" id="btnCloseCatalog" class="cot-create__modal-close">&times;</button>
                </div>
                <div class="cot-create__modal-body">
                    <table class="cot-create__catalog-table">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Descripción</th>
                                <th>Stock</th>
                                <th>Precio</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="cotCatalogBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<script type="application/json" id="cotInitialItems">@Html.Raw(itemsJson)</script>
