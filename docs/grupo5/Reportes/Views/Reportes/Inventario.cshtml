@model List<Hevelab2026.Controllers.ReportesController.RepInventario>
@{
    ViewData["Title"] = "Reporte de Inventario";
    ViewData["Breadcrumbs"] = new[] {
        ("Dashboard", "/"),
        ("Reportes", "/Reportes"),
        ("Inventario", "")
    };
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 no-print">
    <div>
        <h1 class="cl-title">Reportes Analíticos</h1>
        <p class="cl-subtitle">Métricas y datos exportables del sistema</p>
    </div>
</div>

<div class="row">
    <div class="col-12 col-md-3 col-lg-2 no-print">
        @Html.Partial("_MenuReportes")
    </div>
    
    <div class="col-12 col-md-9 col-lg-10">
        <!-- Botonera -->
        <div class="d-flex justify-content-between align-items-center mb-4 no-print">
            <h2 style="font-weight: 800; font-size: 1.2rem; margin: 0; color: var(--sys-primary);">Reporte de Inventario</h2>
            <div class="d-flex gap-2">
                <button type="button" onclick="exportToExcel('tabla-reporte', 'Reporte_Inventario')" class="cl-btn-secondary" style="color: #047857; border-color: #10b981; background: #ecfdf5;">
                    <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                    Exportar Excel
                </button>
                <button type="button" onclick="window.print()" class="cl-btn-primary">
                    <svg viewBox="0 0 24 24"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                    Exportar PDF
                </button>
            </div>
        </div>

        <!-- KPIs -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-lg-6">
                <div class="cl-kpi">
                    <div class="cl-kpi__icon cl-kpi__icon--primary">
                        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                    </div>
                    <div>
                        <div class="cl-kpi__label">Valorización Total</div>
                        <div class="cl-kpi__value" style="color: var(--sys-primary);">S/ 1,310,600.00</div>
                        <div style="font-size: 0.8rem; color: #16a34a; font-weight: 600;">Inventario estable</div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="cl-kpi">
                    <div class="cl-kpi__icon cl-kpi__icon--red" style="background:#fee2e2; color:#ef4444;">
                        <svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    </div>
                    <div>
                        <div class="cl-kpi__label">Productos en Alerta</div>
                        <div class="cl-kpi__value" style="color: #dc2626;">3</div>
                        <div style="font-size: 0.8rem; color: #dc2626; font-weight: 600;">Stock por debajo del mínimo</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Print Header -->
        <div class="print-header" style="display: none; margin-bottom: 20px;">
            <h2 style="color: #1e293b; margin: 0; font-family: sans-serif;">Reporte Analítico: Valorización de Inventario</h2>
            <p style="color: #64748b; margin: 5px 0 0 0; font-family: sans-serif;">Generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        </div>

        <div class="cl-card">
            <div class="cl-table-wrap">
                <table class="cl-table" id="tabla-reporte">
                    <thead>
                        <tr>
                            <th class="cl-th">SKU</th>
                            <th class="cl-th">PRODUCTO</th>
                            <th class="cl-th" style="text-align: right;">CANTIDAD EN STOCK</th>
                            <th class="cl-th" style="text-align: right;">VALOR UNIT.</th>
                            <th class="cl-th" style="text-align: right;">VALOR TOTAL</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model)
                        {
                            <tr class="cl-tr">
                                <td class="cl-td"><span class="cl-mono" style="font-weight: 800; color: var(--sys-primary);">@i.Sku</span></td>
                                <td class="cl-td" style="font-weight: 700;">@i.Producto</td>
                                <td class="cl-td" style="text-align: right; color: @(i.Stock < 50 ? "#dc2626" : "inherit"); font-weight: @(i.Stock < 50 ? "800" : "600");">
                                    @i.Stock
                                </td>
                                <td class="cl-td" style="text-align: right; color: var(--text-secondary);">$@i.ValorUnitario.ToString("N2")</td>
                                <td class="cl-td" style="text-align: right; font-weight: 800; color: var(--sys-primary);">$@((i.Stock * i.ValorUnitario).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="cl-tr" style="background-color: #f8fafc;">
                            <td class="cl-td" colspan="4" style="text-align: right; font-weight: 800;">VALOR TOTAL EN ALMACÉN:</td>
                            <td class="cl-td" style="text-align: right; font-weight: 900; color: var(--sys-primary); font-size: 1.1rem;">$@Model.Sum(x => x.Stock * x.ValorUnitario).ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        @@media print {
            .print-header { display: block !important; }
            .cl-card { box-shadow: none !important; border: none !important; padding: 0 !important; }
            .cl-table th { background-color: #f1f5f9 !important; -webkit-print-color-adjust: exact; border-bottom: 2px solid #000; }
        }
    </style>
    <script>
        function exportToExcel(tableId, filename) {
            let table = document.getElementById(tableId);
            let html = `
                <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
                <head>
                    <meta charset="utf-8" />
                    <style>
                        table { border-collapse: collapse; width: 100%; font-family: sans-serif; }
                        th { background-color: #f8fafc; color: #334155; padding: 10px; border: 1px solid #e2e8f0; font-weight: bold; text-align: left; }
                        td { padding: 10px; border: 1px solid #e2e8f0; color: #0f172a; }
                    </style>
                </head>
                <body>
                    <h2>Reporte Analítico: Valorización de Inventario</h2>
                    <p>Generado el: ${new Date().toLocaleString()}</p>
                    <table>${table.innerHTML}</table>
                </body>
                </html>
            `;
            let blob = new Blob([html], { type: 'application/vnd.ms-excel' });
            let link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = filename + ".xls";
            link.click();
        }
    </script>
}
